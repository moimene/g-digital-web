---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props { title?: string; description?: string }
const {
  title = `${SITE.name}: ${SITE.positioning} | ${SITE.group}`,
  description = `${SITE.tagline} Servicios eIDAS cualificados integrados por API o MCP para que cada operación de tu organización, digital o no, sea evidencia con efectos legales. ${SITE.group}.`,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Rubik:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline src="https://unpkg.com/@phosphor-icons/web"></script>
  <script is:inline defer data-domain="g-digital.garrigues.com" src="https://plausible.io/js/script.js"></script>
</head>
<body>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />

  <script>
    // Menú móvil
    const mm = document.getElementById('mmenu');
    const burger = document.getElementById('burger');
    const close = document.getElementById('mclose');
    const setMenu = (open: boolean) => {
      mm?.classList.toggle('open', open);
      mm?.setAttribute('aria-hidden', String(!open));
      burger?.setAttribute('aria-expanded', String(open));
      if (open) close?.focus();
    };
    burger?.addEventListener('click', () => setMenu(true));
    close?.addEventListener('click', () => setMenu(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenu(false);
    });
    document.querySelectorAll('.mlink').forEach((a) => a.addEventListener('click', () => setMenu(false)));

    // Reveal al hacer scroll
    const revealEls = document.querySelectorAll('.reveal,.stamp');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('in'));
    }

    // Contadores
    const fmt = new Intl.NumberFormat('es-ES');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cio = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement; cio.unobserve(el);
        const to = Number(el.dataset.to || 0), suf = el.dataset.suffix || '';
        if (reduce) { el.textContent = fmt.format(to) + suf; return; }
        const from = to > 100 ? Math.round(to * 0.88) : to;
        if (from === to) { el.textContent = fmt.format(to) + suf; return; }
        const dur = 1100, t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min((t - t0) / dur, 1), e2 = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt.format(Math.round(from + ((to - from) * e2))) + suf;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('.counter').forEach((el) => cio.observe(el));

    // Sombra de nav al hacer scroll
    const nav = document.getElementById('nav');
    addEventListener('scroll', () => nav?.classList.toggle('shadow-2xl', scrollY > 40));
  </script>
</body>
</html>
