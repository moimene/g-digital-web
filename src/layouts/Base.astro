---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;        // ruta absoluta pública, p.ej. /og/default.png
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const {
  title = `${SITE.name}: ${SITE.positioning} | ${SITE.group}`,
  description = `${SITE.umbrella} ${SITE.tagline}`,
  ogImage = '/og/default.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'g-digital',
  url: Astro.site,
  parentOrganization: { '@type': 'Organization', name: 'Garrigues', url: 'https://www.garrigues.com' },
  description: SITE.positioning,
  email: SITE.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content={`${SITE.name} · ${SITE.group}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />
  <meta name="theme-color" content="#05060A" />
  <link rel="preload" href="/fonts/Phosphor-subset.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline defer data-domain="g-digital.garrigues.com" src="https://plausible.io/js/script.js"></script>
</head>
<body>
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-green focus:text-ink focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold">Saltar al contenido</a>
  <Nav />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Footer />

  <script>
    // Menú móvil
    const mm = document.getElementById('mmenu');
    const burger = document.getElementById('burger');
    const close = document.getElementById('mclose');
    const setMenu = (open: boolean) => {
      mm?.classList.toggle('open', open);
      mm?.setAttribute('aria-hidden', String(!open));
      burger?.setAttribute('aria-expanded', String(open));
      if (open) close?.focus();
    };
    burger?.addEventListener('click', () => setMenu(true));
    close?.addEventListener('click', () => setMenu(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenu(false);
    });
    document.querySelectorAll('.mlink').forEach((a) => a.addEventListener('click', () => setMenu(false)));

    // Reveal al hacer scroll (bloques individuales y grupos escalonados)
    const revealEls = document.querySelectorAll('.reveal,.stamp,.reveal-group');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('in'));
    }

    // Contadores
    const fmt = new Intl.NumberFormat('es-ES');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cio = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement; cio.unobserve(el);
        const to = Number(el.dataset.to || 0), suf = el.dataset.suffix || '';
        if (reduce) { el.textContent = fmt.format(to) + suf; return; }
        const from = to > 100 ? Math.round(to * 0.88) : to;
        if (from === to) { el.textContent = fmt.format(to) + suf; return; }
        const dur = 1100, t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min((t - t0) / dur, 1), e2 = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt.format(Math.round(from + ((to - from) * e2))) + suf;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('.counter').forEach((el) => cio.observe(el));

    // Sombra de nav al hacer scroll
    const nav = document.getElementById('nav');
    addEventListener('scroll', () => nav?.classList.toggle('shadow-2xl', scrollY > 40), { passive: true });
  </script>
</body>
</html>
