---
// Barra de "carácter regulado": sellos de confianza cualificada y supervisión.
// Sello eIDAS QTSP y logo EADTrust = imágenes oficiales (public/). ISO/ENS/INCIBE = tiles con códigos reales.
//
// PARA AÑADIR LOS LOGOS OFICIALES restantes (ISO/ENS/INCIBE/Ministerio): copia los PNG a public/certifications/
// y define `img:'/certifications/iso-27001.png'` (etc.) en cada entrada de `certs` (si `img` existe, se usa la imagen).
interface Props {
  title?: string;
  bg?: string;
}
const { title = 'Infraestructura de Confianza Cualificada', bg = 'bg-coal/40' } = Astro.props;

const certs: { code: string; desc: string; ref: string; img?: string }[] = [
  { code: 'ISO 27001', desc: 'Seguridad de la información', ref: 'SI-0318/20' },
  { code: 'ISO 20000', desc: 'Gestión de servicios TI', ref: 'STI-0163/22' },
  { code: 'ISO 9001', desc: 'Gestión de calidad', ref: 'EC-9180/20' },
  { code: 'ENS · ALTA', desc: 'Esquema Nacional de Seguridad', ref: 'RD 311/2022' },
  { code: 'INCIBE', desc: 'Empresa registrada · ciberseguridad', ref: 'Catálogo' },
];
---
<section class={`relative grain ${bg} py-14 lg:py-16 border-y border-cloud/10`}>
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-center gap-2.5 mb-2">
      <i class="ph ph-shield-check text-green text-xl"></i>
      <p class="label text-green tracking-wider text-center">Entorno regulado UE · operado por nuestro QTSP EADTrust</p>
    </div>
    <h2 class="head text-center text-2xl lg:text-3xl text-cloud font-semibold">{title}</h2>

    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 items-stretch">
      <!-- Sello eIDAS QTSP oficial (destacado) -->
      <div class="rounded-2xl border-2 border-green/40 bg-green/5 p-4 flex flex-col items-center text-center justify-center reveal">
        <img src="/certifications/eidas-seal.png" alt="Sello eIDAS · Qualified Trust Service Provider" class="h-16 object-contain" loading="lazy" />
        <p class="head text-cloud font-semibold text-sm mt-2 leading-tight">eIDAS · QTSP</p>
        <p class="mono text-[9px] text-cloud/55 mt-1 leading-tight">Q-Timestamps · Q-Certificates</p>
      </div>

      {certs.map((c) => (
        <div class="rounded-2xl border border-cloud/12 bg-ink/40 p-4 flex flex-col items-center text-center justify-center reveal">
          {c.img
            ? <img src={c.img} alt={c.code} class="h-12 object-contain" loading="lazy" />
            : <>
                <div class="w-11 h-11 rounded-xl bg-cloud/5 border border-cloud/10 flex items-center justify-center"><i class="ph ph-certificate text-green text-2xl"></i></div>
                <p class="head text-cloud font-semibold text-sm mt-3 leading-tight">{c.code}</p>
                <p class="text-cloud/50 text-[10px] mt-1 leading-tight">{c.desc}</p>
                <p class="mono text-[9px] text-cloud/40 mt-1">{c.ref}</p>
              </>}
        </div>
      ))}
    </div>

    <!-- Operación + supervisión -->
    <div class="mt-6 rounded-2xl border border-cloud/10 bg-ink/40 px-6 py-5 flex flex-col sm:flex-row items-center justify-center gap-x-4 gap-y-3 text-center">
      <span class="inline-flex items-center gap-2 text-cloud/55 text-sm">Operado por <span class="bg-white rounded-md px-2.5 py-1 inline-flex"><img src="/brands/ead-trust.png" alt="EADTrust" class="h-5 object-contain" loading="lazy" /></span></span>
      <span class="hidden sm:inline text-cloud/20">·</span>
      <span class="text-cloud/55 text-sm">Autorizada y supervisada por el <span class="text-cloud font-semibold">Ministerio para la Transformación Digital y de la Función Pública</span> · Gobierno de España</span>
    </div>

    <p class="mono text-[11px] text-cloud/45 mt-6 text-center">Reglamento (UE) 910/2014 (eIDAS) · RD 311/2022 (ENS) · LOPDGDD</p>
  </div>
</section>
