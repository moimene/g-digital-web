---
// CTA final editorial. Por defecto tinta; envolver en la superficie deseada.
interface Props {
  kicker?: string;
  title: string;
  sub?: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
  note?: string;
}
const { kicker, title, sub, primary, secondary, note } = Astro.props;
---
<section class="relative overflow-hidden border-t border-cloud/10">
  <div class="relative max-w-4xl mx-auto px-6 py-24 lg:py-28 text-center">
    {kicker && (
      <p class="stamp inline-flex items-center gap-2 mono text-[11px] tracking-widest accent border rounded-full px-4 py-1.5 mb-8" style="border-color:rgba(var(--accent-rgb),.4)">
        <i class="ph ph-shield-check" aria-hidden="true"></i> {kicker}
      </p>
    )}
    <h2 class="display-2 t1 font-semibold">{title}</h2>
    {sub && <p class="mt-6 t2 max-w-xl mx-auto text-lg leading-relaxed">{sub}</p>}
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a href={primary.href} class="btn-primary px-8 py-4 rounded-xl">{primary.label}</a>
      {secondary && <a href={secondary.href} class="btn-outline px-8 py-4 rounded-xl">{secondary.label}</a>}
    </div>
    {note && <p class="mono text-[11px] t3 mt-8">{note}</p>}
  </div>
</section>
