---
// Simulador reutilizable del Trust Explorer + certificado QTSP nativo.
// Recibe `casos` (CasoUso[]). Usado por /escenarios y por las páginas sectoriales.
import { MANAGER_META, type CasoUso } from '../data/casos-uso';

interface Props {
  casos: CasoUso[];
  kicker?: string;
  title?: string;
  subtitle?: string;
}
const { casos, kicker = 'Casos de uso', title = 'Elige una operación para simularla.', subtitle = 'Cada caso muestra el evento del cliente, la llamada a la API y el resultado legal con y sin la capa de confianza.' } = Astro.props;
const first = casos[0];
const managersOrder = ['Evidence', 'Signature', 'Notification', 'Custody'] as const;
---
<!-- SELECTOR -->
<section class="relative grain py-20 lg:py-24 " id="explorer">
  <div class="max-w-7xl mx-auto px-6">
    <p class="label text-green mb-3">{kicker}</p>
    <h2 class="head display text-3xl lg:text-[2.4rem] text-cloud font-semibold">{title}</h2>
    <p class="mt-4 text-cloud/60 max-w-2xl">{subtitle}</p>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {casos.map((c, i) => (
        <button type="button" class="caso-btn group text-left card rounded-2xl p-5 border-2 transition-all reveal" data-id={c.id} aria-pressed={i === 0 ? 'true' : 'false'} style={`--tone:${c.tone}`}>
          <div class="flex items-center justify-between mb-4">
            <span class="w-10 h-10 rounded-xl flex items-center justify-center" style={`background:${c.tone}1f;color:${c.tone}`}><i class={`ph ${c.icon} text-xl`}></i></span>
            <span class="mono text-[10px] text-cloud/50 tracking-wider uppercase">{c.sector}</span>
          </div>
          <h3 class="head text-cloud font-semibold leading-snug group-hover:text-green transition-colors">{c.title}</h3>
          <p class="text-cloud/55 text-xs mt-2 leading-relaxed line-clamp-3">{c.resumen}</p>
          <span class="inline-flex items-center gap-1.5 text-green text-xs font-medium mt-4">Ver simulación <i class="ph ph-arrow-right"></i></span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- SIMULADOR -->
<section class="relative grain bg-coal/60 py-16 lg:py-20 border-y border-cloud/10">
  <div id="sim" class="max-w-7xl mx-auto px-6" style={`--tone:${first.tone}`}>
    <div class="flex items-center gap-3 mb-8">
      <span id="sim-icon-wrap" class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0" style={`background:${first.tone}1f;color:${first.tone}`}><i id="sim-icon" class={`ph ${first.icon} text-2xl`}></i></span>
      <div>
        <p id="sim-sector" class="mono text-[11px] text-cloud/50 uppercase tracking-wider">{first.sector}</p>
        <h2 id="sim-title" class="head text-2xl text-cloud font-semibold leading-tight">{first.title}</h2>
      </div>
    </div>

    <!-- DIAGRAMA API MÓVIL -->
    <div class="rounded-2xl border border-cloud/10 bg-ink/40 p-6 lg:p-8 reveal">
      <p class="label text-green mb-6">Flujo de la API</p>
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center gap-4 lg:gap-2">
        <div class="shrink-0 mx-auto lg:mx-0">
          <div class="w-[150px] h-[230px] rounded-[1.6rem] border-2 p-2 bg-coal relative" style="border-color:color-mix(in srgb, var(--tone) 55%, transparent)">
            <div class="absolute top-2 left-1/2 -translate-x-1/2 w-12 h-1.5 rounded-full bg-cloud/20"></div>
            <div class="h-full rounded-[1.1rem] bg-ink/80 p-3 flex flex-col">
              <i id="dg-app-icon" class={`ph ${first.icon} text-2xl`} style="color:var(--tone)"></i>
              <p id="dg-event" class="text-cloud/80 text-[11px] mt-2 leading-snug font-medium">{first.event.title}</p>
              <p class="mono text-[9px] text-cloud/40 mt-auto">cliente · app</p>
            </div>
          </div>
        </div>
        <div class="flex lg:flex-col items-center justify-center gap-2 px-2">
          <i class="ph ph-arrow-right text-cloud/40 text-xl hidden lg:block"></i>
          <i class="ph ph-arrow-down text-cloud/40 text-xl lg:hidden"></i>
          <code id="dg-endpoint" class="mono text-[10px] px-2 py-1 rounded-md bg-ink border whitespace-normal break-all lg:whitespace-nowrap" style="border-color:color-mix(in srgb, var(--tone) 45%, transparent);color:var(--tone)">{first.api.method} {first.api.endpoint}</code>
        </div>
        <div class="flex-1 rounded-xl border border-cloud/10 p-4">
          <p class="mono text-[10px] text-cloud/45 mb-3 text-center">FACTORÍA · MICROSERVICIOS</p>
          <div class="grid grid-cols-2 gap-2.5">
            {managersOrder.map((m) => (
              <div class="dg-mgr rounded-lg border border-cloud/10 px-3 py-2.5 flex items-center gap-2 opacity-35 transition-all" data-mgr={m}>
                <i class={`ph ${MANAGER_META[m].icon} text-base`}></i>
                <span class="text-[11px] text-cloud/80 leading-tight">{MANAGER_META[m].label}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="flex lg:flex-col items-center justify-center gap-2 px-2">
          <i class="ph ph-arrow-right text-cloud/40 text-xl hidden lg:block"></i>
          <i class="ph ph-arrow-down text-cloud/40 text-xl lg:hidden"></i>
        </div>
        <div class="shrink-0 mx-auto lg:mx-0 text-center">
          <div class="w-[120px] rounded-xl border border-green/40 bg-green/10 p-4">
            <i class="ph ph-seal-check text-green text-3xl"></i>
            <p class="text-cloud/85 text-[11px] mt-2 font-medium leading-snug">Evidencia sellada</p>
            <p class="mono text-[9px] text-cloud/45 mt-1">verificable · eIDAS</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Evento + API + Resultado -->
    <div class="mt-6 grid lg:grid-cols-2 gap-6">
      <div class="space-y-6">
        <div class="card rounded-2xl p-6 reveal">
          <p class="mono text-[11px] text-cloud/45 mb-2">01 · EVENTO DEL CLIENTE</p>
          <h3 id="ev-title" class="head text-lg text-cloud font-semibold">{first.event.title}</h3>
          <p id="ev-desc" class="text-cloud/65 text-sm mt-2 leading-relaxed">{first.event.description}</p>
          <p id="ev-details" class="mono text-[11px] text-cloud/50 mt-3 border-t border-cloud/10 pt-3">{first.event.details}</p>
        </div>
        <div class="card rounded-2xl p-6 reveal">
          <p class="mono text-[11px] text-cloud/45 mb-2">02 · LLAMADA A LA API</p>
          <code class="mono text-xs px-2.5 py-1 rounded-md bg-ink border border-green/40 text-green inline-block"><span id="api-method">{first.api.method}</span> <span id="api-endpoint">{first.api.endpoint}</span></code>
          <pre class="mt-3 rounded-xl bg-ink border border-cloud/10 p-4 overflow-x-auto text-[11px] leading-relaxed"><code id="api-payload" class="mono text-cloud/75">{JSON.stringify(first.api.payload, null, 2)}</code></pre>
        </div>
      </div>
      <div class="space-y-6">
        <div class="card rounded-2xl p-6 reveal">
          <p class="mono text-[11px] text-cloud/45 mb-4">03 · RESULTADO LEGAL</p>
          <div class="rounded-xl border border-red-500/30 bg-red-500/5 p-4">
            <div class="flex items-center justify-between">
              <p class="mono text-[10px] text-red-400/90">SIN REGULACIÓN</p>
              <span id="sin-risk" class="mono text-[9px] px-1.5 py-0.5 rounded bg-red-500/20 text-red-300">RIESGO ALTO</span>
            </div>
            <h4 id="sin-status" class="head text-cloud font-semibold mt-1 flex items-center gap-2"><i class="ph ph-warning-circle text-red-400"></i>{first.sin.status}</h4>
            <p id="sin-desc" class="text-cloud/60 text-sm mt-2 leading-relaxed">{first.sin.description}</p>
          </div>
          <div class="rounded-xl border border-green/30 bg-green/5 p-4 mt-4">
            <p class="mono text-[10px] text-green mb-1">CON TRUST API</p>
            <h4 id="con-status" class="head text-cloud font-semibold flex items-center gap-2"><i class="ph ph-seal-check text-green"></i>{first.con.status}</h4>
            <p id="con-desc" class="text-cloud/60 text-sm mt-2 leading-relaxed">{first.con.description}</p>
          </div>
        </div>
        <div class="card rounded-2xl p-6 reveal">
          <div class="flex items-center justify-between mb-3">
            <p class="mono text-[11px] text-cloud/45">ANÁLISIS JURÍDICO</p>
            <span id="norma" class="mono text-[10px] px-2 py-0.5 rounded-full border border-green/40 text-green">{first.norma}</span>
          </div>
          <p id="analysis" class="text-cloud/70 text-sm leading-relaxed">{first.analysis}</p>
        </div>
        <button id="cert-open" type="button" class="w-full bg-green text-ink px-6 py-4 rounded-xl font-semibold hover:bg-lime transition-colors inline-flex items-center justify-center gap-2">
          <i class="ph ph-certificate text-lg"></i> Ver certificado QTSP de la operación
        </button>
      </div>
    </div>

    <p class="mono text-[11px] text-cloud/40 mt-6 text-center">Demo ilustrativa · datos sintéticos · endpoints de ejemplo</p>
  </div>
</section>

<!-- Datos para el script -->
<script type="application/json" id="ts-casos" set:html={JSON.stringify(casos)}></script>

<!-- MODAL CERTIFICADO QTSP -->
<div id="qtsp-modal" class="hidden fixed inset-0 z-[100] bg-black/75 backdrop-blur-sm overflow-y-auto p-4 sm:p-8">
  <div class="max-w-3xl mx-auto">
    <div class="flex flex-wrap justify-end gap-2 mb-3 no-print">
      {/* VALIDAR plan:gdw:w-factoria-arquitectura #35 */}
      <button id="qtsp-print" type="button" class="bg-green text-ink px-4 py-2 rounded-lg font-semibold text-sm inline-flex items-center gap-1.5"><i class="ph ph-printer"></i> Imprimir / PDF</button>
      <a id="qtsp-tsl" href="https://eidas.ec.europa.eu/efda/trust-services/browse/eidas/tls/tl/ES/tsp/40" target="_blank" rel="noopener" class="border border-cloud/30 text-cloud px-4 py-2 rounded-lg text-sm inline-flex items-center gap-1.5 hover:bg-cloud/10">EU Trust List <i class="ph ph-arrow-up-right"></i></a>
      <button id="qtsp-close" type="button" class="border border-cloud/30 text-cloud px-4 py-2 rounded-lg text-sm inline-flex items-center gap-1.5 hover:bg-cloud/10"><i class="ph ph-x"></i> Cerrar</button>
    </div>
    <div id="qtsp-cert" style="background:#F8F7F4;color:#1a1a1a;border-radius:8px;"></div>
  </div>
</div>

<style is:global>
  @media print {
    body * { visibility: hidden !important; }
    #qtsp-modal, #qtsp-modal * { visibility: visible !important; }
    #qtsp-modal { position: absolute !important; inset: 0 !important; background: #fff !important; padding: 0 !important; overflow: visible !important; }
    #qtsp-modal .no-print { display: none !important; }
  }
</style>

<script>
  import { buildCertificate, formatCertificateDate, truncateHash } from '../lib/certificate';

  const casos = JSON.parse(document.getElementById('ts-casos')!.textContent || '[]');
  const byId = (id: string) => document.getElementById(id);
  const sim = byId('sim')!;
  const map: Record<string, any> = Object.fromEntries(casos.map((c: any) => [c.id, c]));
  let current: any = casos[0];

  function paintManagers(c: any) {
    document.querySelectorAll('.dg-mgr').forEach((el) => {
      const on = c.managers.includes((el as HTMLElement).dataset.mgr);
      (el as HTMLElement).style.opacity = on ? '1' : '0.35';
      (el as HTMLElement).style.borderColor = on ? c.tone : '';
      (el as HTMLElement).style.background = on ? (c.tone + '12') : '';
    });
  }

  function render(c: any) {
    current = c;
    sim.style.setProperty('--tone', c.tone);
    byId('sim-sector')!.textContent = c.sector;
    byId('sim-title')!.textContent = c.title;
    const iconWrap = byId('sim-icon-wrap')!;
    iconWrap.style.background = c.tone + '1f';
    iconWrap.style.color = c.tone;
    byId('sim-icon')!.className = 'ph ' + c.icon + ' text-2xl';
    byId('dg-app-icon')!.className = 'ph ' + c.icon + ' text-2xl';
    byId('dg-event')!.textContent = c.event.title;
    byId('dg-endpoint')!.textContent = c.api.method + ' ' + c.api.endpoint;
    paintManagers(c);
    byId('ev-title')!.textContent = c.event.title;
    byId('ev-desc')!.textContent = c.event.description;
    byId('ev-details')!.textContent = c.event.details;
    byId('api-method')!.textContent = c.api.method;
    byId('api-endpoint')!.textContent = c.api.endpoint;
    byId('api-payload')!.textContent = JSON.stringify(c.api.payload, null, 2);
    byId('sin-status')!.innerHTML = '<i class="ph ph-warning-circle text-red-400"></i>' + c.sin.status;
    byId('sin-desc')!.textContent = c.sin.description;
    byId('sin-risk')!.textContent = c.sin.riesgo === 'critical' ? 'RIESGO CRÍTICO' : 'RIESGO ALTO';
    byId('con-status')!.innerHTML = '<i class="ph ph-seal-check text-green"></i>' + c.con.status;
    byId('con-desc')!.textContent = c.con.description;
    byId('analysis')!.textContent = c.analysis;
    byId('norma')!.textContent = c.norma;
  }

  document.querySelectorAll('.caso-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.caso-btn').forEach((b) => {
        b.setAttribute('aria-pressed', 'false');
        (b as HTMLElement).style.borderColor = '';
      });
      btn.setAttribute('aria-pressed', 'true');
      (btn as HTMLElement).style.borderColor = (btn as HTMLElement).style.getPropertyValue('--tone');
      const c = map[(btn as HTMLElement).dataset.id!];
      if (c) render(c);
      sim.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  if (casos[0]) {
    paintManagers(casos[0]);
    const f = document.querySelector('.caso-btn') as HTMLElement | null;
    if (f) f.style.borderColor = casos[0].tone;
  }

  // ---------- Certificado QTSP ----------
  function loadQR(): Promise<void> {
    return new Promise((res) => {
      if ((window as any).QRCode) return res();
      const s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
      s.onload = () => res();
      s.onerror = () => res();
      document.head.appendChild(s);
    });
  }

  async function sha256(obj: any): Promise<string> {
    try {
      const enc = new TextEncoder().encode(JSON.stringify(obj));
      const buf = await crypto.subtle.digest('SHA-256', enc);
      return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');
    } catch { return ''; }
  }

  const esc = (s: any) => String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m] as string));

  async function openCertificate(c: any) {
    const d = buildCertificate(c);
    const realHash = (await sha256(c.api.payload)) || d.evidence.hash;
    const services = d.qtsp.qualified_services.map((s) => `<span style="display:inline-block;background:#00336612;color:#003366;border-radius:999px;padding:2px 8px;font-size:10px;margin:2px">${esc(s)}</span>`).join('');
    const statements = d.legal_declaration.statements.map((s, i) => `<li style="margin:6px 0;font-size:12px;line-height:1.5"><span style="color:#003366;font-weight:700">${i + 1}.</span> ${esc(s)}</li>`).join('');
    const payloadStr = esc(JSON.stringify(d.evidence.payload, null, 2));

    const cert = byId('qtsp-cert')!;
    // VALIDAR plan:gdw:w-factoria-arquitectura #35
    cert.innerHTML = `
      <div style="padding:20px;position:relative">
      <div style="position:absolute;top:45%;left:5%;width:90%;text-align:center;transform:rotate(-20deg);color:#555;font:700 24px sans-serif;opacity:.65;pointer-events:none;z-index:2">ESPÉCIMEN · SIN VALOR PROBATORIO</div>
       <div style="border:2px solid #003366;border-radius:6px;padding:4px">
        <div style="border:1px solid #003366;border-radius:4px;padding:22px 24px;font-family:Georgia,'Times New Roman',serif">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;border-bottom:1px solid #00336633;padding-bottom:12px">
            <div style="display:flex;align-items:center;gap:10px">
              <img src="/brands/ead-trust.png" alt="EADTrust" style="height:26px;object-fit:contain"/>
              <span style="font-size:11px;color:#4a4a4a">${esc(d.qtsp.legal_name)}</span>
            </div>
            <img src="/certifications/eidas-seal.png" alt="eIDAS QTSP" style="height:42px;object-fit:contain"/>
          </div>

          <h2 style="text-align:center;color:#003366;font-size:18px;letter-spacing:1px;margin:18px 0 4px">CERTIFICADO DE EVIDENCIA (simulación)</h2>
          <p style="text-align:center;color:#003366;font-size:13px;letter-spacing:3px;margin:0 0 14px">ELECTRÓNICA CUALIFICADA</p>

          <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;font-family:monospace;font-size:11px;color:#4a4a4a;background:#00336608;border-radius:4px;padding:8px 12px">
            <span><b style="color:#1a1a1a">Nº:</b> ${esc(d.metadata.certificate_id)}</span>
            <span><b style="color:#1a1a1a">Fecha:</b> ${esc(formatCertificateDate(d.metadata.issued_at))}</span>
          </div>

          <p style="color:#003366;font-weight:700;font-size:12px;margin:16px 0 4px;border-left:3px solid #003366;padding-left:8px">PRESTADOR DE SERVICIOS DE CONFIANZA</p>
          <p style="font-size:12px;margin:2px 0"><b>${esc(d.qtsp.legal_name)}</b> · NIF ${esc(d.qtsp.vat_id)}</p>
          <div style="margin-top:4px">${services}</div>

          <p style="color:#003366;font-weight:700;font-size:12px;margin:16px 0 4px;border-left:3px solid #003366;padding-left:8px">DATOS DE LA EVIDENCIA</p>
          <table style="width:100%;font-size:12px;border-collapse:collapse">
            <tr><td style="color:#4a4a4a;padding:2px 0;width:140px">Evidence ID</td><td style="font-family:monospace">${esc(d.evidence.evidence_id)}</td></tr>
            <tr><td style="color:#4a4a4a;padding:2px 0">Tipo</td><td>${esc(d.evidence.evidence_type)}</td></tr>
            <tr><td style="color:#4a4a4a;padding:2px 0">Categoría</td><td>${esc(d.evidence.category)}</td></tr>
            <tr><td style="color:#4a4a4a;padding:2px 0">Operación</td><td>${esc(d.evidence.operation.name)}</td></tr>
            <tr><td style="color:#4a4a4a;padding:2px 0">Sello de tiempo</td><td style="font-family:monospace">${esc(d.evidence.timestamp)} · ${esc(d.evidence.precision)}</td></tr>
          </table>
          <pre style="background:#00336608;border:1px solid #00336622;border-radius:4px;padding:10px;font-size:10px;overflow:auto;margin-top:8px;max-height:180px">${payloadStr}</pre>
          <div style="background:#2d5a3e10;border:1px solid #2d5a3e44;border-radius:4px;padding:8px 10px;margin-top:8px">
            <span style="color:#2d5a3e;font-weight:700;font-size:10px">SHA-256</span>
            <p style="font-family:monospace;font-size:10px;color:#2d5a3e;word-break:break-all;margin:2px 0 0">${esc(realHash)}</p>
          </div>

          <p style="color:#003366;font-weight:700;font-size:12px;margin:16px 0 4px;border-left:3px solid #003366;padding-left:8px">DECLARACIÓN LEGAL</p>
          <p style="font-size:11px;color:#4a4a4a;margin:0 0 4px">${esc(d.legal_declaration.header)}</p>
          <ol style="margin:0;padding-left:4px;list-style:none">${statements}</ol>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px;align-items:center">
            <div style="text-align:center">
              <div id="qtsp-qr" style="display:inline-block;background:#fff;padding:6px;border:1px solid #00336633;border-radius:4px"></div>
              <p style="font-size:9px;color:#4a4a4a;margin:6px 0 0">verify.eadtrust.eu</p>
            </div>
            <div style="text-align:center">
              <svg viewBox="0 0 120 120" width="104" height="104">
                <defs><path id="qsealpath" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
                <circle cx="60" cy="60" r="54" fill="none" stroke="#003366" stroke-width="2"/>
                <circle cx="60" cy="60" r="46" fill="none" stroke="#003366" stroke-width="1"/>
                <text fill="#003366" font-size="7.5" font-weight="bold" letter-spacing="1.5"><textPath href="#qsealpath" startOffset="0">· EADTRUST · QUALIFIED TRUST SERVICE PROVIDER </textPath></text>
                <text x="60" y="52" text-anchor="middle" font-size="13" font-weight="bold" fill="#003366" font-family="Georgia,serif">QTSP</text>
                <text x="60" y="66" text-anchor="middle" font-size="8" fill="#003366" font-family="Georgia,serif">eIDAS · EADTrust</text>
                <path d="M46 80 l8 8 18 -20" stroke="#f0b400" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

          <div style="background:#fffbeb;border:1px solid #f59e0b55;border-radius:4px;padding:8px 12px;margin-top:16px">
            <p style="color:#92400e;font-size:10px;margin:0">⚠️ ${esc(d.legal_declaration.disclaimer)}</p>
          </div>
        </div>
       </div>
      </div>`;

    (byId('qtsp-modal') as HTMLElement).classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    await loadQR();
    const qrEl = byId('qtsp-qr');
    if (qrEl && (window as any).QRCode) {
      qrEl.innerHTML = '';
      new (window as any).QRCode(qrEl, { text: d.verification.qr_data, width: 92, height: 92, colorDark: '#003366', colorLight: '#ffffff' });
    }
  }

  function closeCert() {
    (byId('qtsp-modal') as HTMLElement).classList.add('hidden');
    document.body.style.overflow = '';
  }

  byId('cert-open')?.addEventListener('click', () => openCertificate(current));
  byId('qtsp-close')?.addEventListener('click', closeCert);
  byId('qtsp-print')?.addEventListener('click', () => window.print());
  byId('qtsp-modal')?.addEventListener('click', (e) => { if (e.target === byId('qtsp-modal')) closeCert(); });
</script>
