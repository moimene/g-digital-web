---
// Índice sticky del artículo (scrollspy vanilla sobre los H2/H3 del cuerpo).
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[] }
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 1 && (
  <nav aria-label="Índice del artículo" class="toc">
    <p class="label t3 mb-4">En esta página</p>
    <ul class="space-y-2.5 text-sm border-l pl-4" style="border-color:var(--line)">
      {items.map((h) => (
        <li>
          <a href={`#${h.slug}`} data-toc={h.slug}
             class={`toc-link t2 hover:text-[var(--t1)] transition-colors block leading-snug ${h.depth === 3 ? 'pl-3 text-[13px]' : ''}`}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  const tocLinks = document.querySelectorAll('.toc-link');
  if (tocLinks.length && 'IntersectionObserver' in window) {
    const map = new Map<string, Element>();
    tocLinks.forEach((l) => map.set((l as HTMLElement).dataset.toc!, l));
    const spy = new IntersectionObserver((es) => {
      es.forEach((e) => {
        const link = map.get(e.target.id);
        if (!link) return;
        if (e.isIntersecting) {
          tocLinks.forEach((l) => l.classList.remove('toc-active'));
          link.classList.add('toc-active');
        }
      });
    }, { rootMargin: '-80px 0px -65% 0px' });
    map.forEach((_, slug) => { const el = document.getElementById(slug); if (el) spy.observe(el); });
  }
</script>

<style>
  .toc-active{ color:var(--accent) !important; font-weight:500 }
</style>
