---
// Recursos relacionados (por slugs cross-colección). Filas editoriales, no cards.
import { getCollection } from 'astro:content';
import { LINEAS_RECURSOS } from '../../content/config';

interface Props { slugs: string[]; currentSlug?: string }
const { slugs } = Astro.props;

const [arts, cons, cas] = await Promise.all([
  getCollection('articulos'), getCollection('conceptos'), getCollection('casos'),
]);
const all = [
  ...arts.map((e) => ({ ...e, base: '/recursos/articulos', tipo: 'Artículo' })),
  ...cons.map((e) => ({ ...e, base: '/recursos/conceptos', tipo: 'Concepto' })),
  ...cas.map((e) => ({ ...e, base: '/recursos/casos', tipo: 'Caso de uso' })),
];
const items = slugs.map((s) => all.find((e) => e.slug === s)).filter(Boolean) as typeof all;
---
{items.length > 0 && (
  <div>
    <p class="label t3 mb-6">Sigue profundizando</p>
    <div>
      {items.map((e) => (
        <a href={`${e!.base}/${e!.slug}`} class="group grid sm:grid-cols-12 gap-x-6 gap-y-1 py-5 border-t items-baseline reveal" style="border-color:var(--line)">
          <span class="sm:col-span-2 mono text-[11px] t3">{e!.tipo} · {LINEAS_RECURSOS[e!.data.linea]}</span>
          <span class="sm:col-span-8 head t1 font-semibold leading-snug group-hover:text-[var(--accent)] transition-colors">{e!.data.title}</span>
          <span class="sm:col-span-2 inline-flex sm:justify-end items-center gap-1.5 accent text-sm font-medium">Leer <i class="ph ph-arrow-right transition-transform group-hover:translate-x-1" aria-hidden="true"></i></span>
        </a>
      ))}
      <div class="border-t" style="border-color:var(--line)"></div>
    </div>
  </div>
)}
