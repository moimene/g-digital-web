---
import Base from '../layouts/Base.astro';
import Wireframe from '../components/Wireframe.astro';
import SectionLabel from '../components/SectionLabel.astro';
import HeroRoller from '../components/HeroRoller.astro';
import { articulos } from '../data/articulos';
import { LINEAS, SITE } from '../consts';

const heroPhrases = [
  'inyectar cumplimiento en tus procesos',
  'mitigar tu riesgo legal',
  'automatizar tus contratos',
  'tokenizar RWA regulados',
  'conectar tus agentes de IA por MCP',
  'establecer tu QTSP <em>in-house</em>',
  'ser una organización <em>EUDI&nbsp;Wallet&nbsp;ready</em>',
  'dar validez probatoria a cada operación',
];
const palancas = [
  { icon: 'ph-scales', t: 'Garrigues', k: 'Conocimiento jurídico', d: 'Primer despacho de la UE. El derecho incorporado desde el diseño: regulación, validez y gobierno corporativo.' },
  { icon: 'ph-code', t: 'g-digital', k: 'Producto y tecnología', d: 'Traducimos requisitos legales en productos que funcionan: de la app integrable a la API/MCP en el core.' },
  { icon: 'ph-certificate', t: 'EADTrust', k: 'Operación regulada · QTSP', d: 'Prestador cualificado bajo eIDAS, participado al 51% por Garrigues. Opera y da el entorno regulado.' },
];
const comparten = [
  { icon: 'ph-scales', t: 'Criterio jurídico de Garrigues', d: 'Cada solución nace con el derecho incorporado, no añadido después.' },
  { icon: 'ph-seal-check', t: 'Operación regulada', d: 'EADTrust, QTSP del grupo, opera y respalda lo que diseñamos.' },
  { icon: 'ph-rocket-launch', t: 'Tecnología en producción', d: 'No PowerPoint: producto real, integrable y medible.' },
];
---
<Base>
  <!-- HERO -->
  <header class="relative grain overflow-hidden border-b border-cloud/10">
    <Wireframe variant="sphere" density="strong" class="absolute right-[-11rem] top-24 translate-y-0 w-[24rem] h-[24rem] opacity-25 md:right-[-7rem] md:top-1/2 md:-translate-y-1/2 md:w-[36rem] md:h-[36rem] md:opacity-75" />
    <div class="relative max-w-7xl mx-auto px-6 pt-24 pb-28 lg:pt-32 lg:pb-36">
      <p class="label text-green mb-8 reveal">g-digital · Grupo Garrigues</p>
      <h1 class="head display text-cloud font-semibold max-w-5xl reveal">
        <span class="block text-[2.55rem] sm:text-6xl lg:text-[5.1rem]">Tecnología para</span>
        <span class="block mt-3 min-h-[6.8rem] text-[2.05rem] leading-[1.08] sm:min-h-[3.5rem] sm:text-5xl lg:min-h-[5rem] lg:text-[4.45rem]">
          <HeroRoller phrases={heroPhrases} />
        </span>
      </h1>
      <p class="sr-only">Tecnología para inyectar cumplimiento en tus procesos, mitigar tu riesgo legal, automatizar tus contratos, tokenizar RWA regulados, conectar tus agentes de IA por MCP, establecer tu QTSP in-house, ser una organización EUDI Wallet ready y dar validez probatoria a cada operación.</p>
      <p class="mt-9 max-w-2xl text-lg lg:text-xl text-cloud/70 leading-relaxed reveal">
        El <span class="text-cloud font-semibold">brazo tecnológico de Garrigues</span>: cuatro líneas que convierten la complejidad jurídica en tecnología que funciona — <span class="text-cloud">confianza digital</span>, <span class="text-cloud">contratos</span>, <span class="text-cloud">activos digitales</span> y <span class="text-cloud">GRC&nbsp;e&nbsp;IA</span>. Cada una con su propio terreno.
      </p>
      <p class="mt-4 text-cloud/60 text-sm reveal">Tecnología real para situaciones de alta complejidad jurídica. Diseñado por Garrigues. Operado por EADTrust (QTSP bajo eIDAS).</p>
      <div class="mt-11 flex flex-col sm:flex-row gap-4 reveal">
        <a href="#lineas" class="group inline-flex items-center justify-center gap-2 bg-green text-ink px-7 py-4 rounded-xl font-semibold hover:bg-lime transition-colors">Ver las 4 líneas <i class="ph ph-arrow-down group-hover:translate-y-0.5 transition-transform"></i></a>
        <a href="/contacto" class="inline-flex items-center justify-center gap-2 border border-cloud/25 text-cloud px-7 py-4 rounded-xl font-medium hover:bg-cloud/5 transition-colors">Habla con un experto</a>
      </div>
    </div>
    <div class="relative border-t border-cloud/10">
      <div class="max-w-7xl mx-auto px-6 py-7 grid grid-cols-2 lg:grid-cols-4 gap-y-6 text-cloud/70">
        <div class="flex items-center gap-3"><i class="ph ph-stack text-green text-xl"></i><span class="text-sm">4 líneas de negocio</span></div>
        <div class="flex items-center gap-3"><i class="ph ph-seal-check text-green text-xl"></i><span class="text-sm">QTSP propio (EADTrust, 51% Garrigues)</span></div>
        <div class="flex items-center gap-3"><i class="ph ph-trophy text-green text-xl"></i><span class="text-sm">Top 10 · FT Innovative Lawyers Europa</span></div>
        <div class="flex items-center gap-3"><i class="ph ph-buildings text-green text-xl"></i><span class="text-sm">Tecnología en producción real</span></div>
      </div>
    </div>
  </header>

  <!-- 01 · LAS CUATRO LÍNEAS -->
  <section id="lineas" class="relative grain py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl reveal">
        <SectionLabel num="01" text="Las cuatro líneas" />
        <h2 class="head display text-4xl lg:text-[3.3rem] text-cloud font-semibold">Cuatro negocios. Una casa.</h2>
        <p class="mt-7 text-cloud/70 leading-relaxed">{SITE.umbrella} Cada línea resuelve un problema distinto y habla su propio idioma: <span class="text-cloud">no todo es eIDAS</span>. Esto es lo que hacemos, y dónde.</p>
      </div>
      <div class="mt-14 grid lg:grid-cols-2 gap-6">
        {LINEAS.map((l) => (
          <a href={l.href} class="card rounded-3xl p-8 reveal block">
            <div class="flex items-center justify-between">
              <i class={`ph ${l.icon} ${l.toneText} text-3xl`}></i>
              <span class="label text-cloud/55">Línea {l.n}</span>
            </div>
            <p class={`label ${l.toneText} mt-5`}>{l.kicker}</p>
            <h3 class="head text-2xl text-cloud mt-1 font-semibold">{l.title}</h3>
            <p class="text-cloud/85 mt-3 leading-relaxed">{l.promesa}</p>
            <p class="text-cloud/55 text-sm mt-2 leading-relaxed">{l.desc}</p>
            <div class="mt-6 space-y-2.5 text-sm">
              {l.keys.map(([k, v]) => (
                <div class="flex items-center gap-3 text-cloud/85"><span class={`mono text-[11px] ${l.toneText} w-32 shrink-0`}>{k}</span> {v}</div>
              ))}
            </div>
            <span class={`link-underline inline-flex items-center gap-2 ${l.toneText} text-sm font-medium mt-7`}>Ver {l.title} <i class="ph ph-arrow-right"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 · TRES PALANCAS (el modelo / paraguas) -->
  <section class="relative grain bg-coal/60 py-24 lg:py-32 border-y border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl reveal">
        <SectionLabel num="02" text="Una sola casa" />
        <h2 class="head display text-4xl lg:text-[3.1rem] text-cloud font-semibold">Lo que comparten las cuatro líneas.</h2>
        <p class="mt-7 text-cloud/70 leading-relaxed">No un producto común, sino una forma de trabajar: derecho de Garrigues + tecnología propia + operación regulada. Tres palancas que ningún actor ofrece por separado.</p>
      </div>
      <div class="mt-14 grid md:grid-cols-3 gap-8">
        {palancas.map((p) => (
          <div class="reveal"><div class="hairline mb-6"></div><i class={`ph ${p.icon} text-green text-3xl`}></i><h3 class="head text-2xl text-cloud mt-4 font-semibold">{p.t}</h3><p class="label text-cloud/55 mt-2">{p.k}</p><p class="text-cloud/65 text-sm mt-4 leading-relaxed">{p.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · LA FACTORÍA (producto estrella de Confianza Digital) -->
  <section id="factoria" class="relative grain py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-14 items-center">
      <div class="lg:col-span-5 reveal">
        <SectionLabel num="03" text="Confianza Digital · producto estrella" color="text-green" />
        <h2 class="head display text-4xl lg:text-[3.1rem] text-cloud font-semibold">Una llamada. Cualquier proceso. <span class="green-text">Validez legal.</span></h2>
        <p class="mt-7 text-cloud/70 leading-relaxed">Dentro de Confianza Digital, <span class="text-cloud font-semibold">La Factoría</span> es nuestra API como producto: cuatro microservicios eIDAS (evidencia, firma, notificación y custodia) que inyectas en cualquier sistema sin migrar plataformas.</p>
        <div class="mt-7 rounded-xl bg-green/10 border border-green/30 p-5">
          <p class="text-green font-semibold flex items-center gap-2"><i class="ph ph-robot"></i> Ahora también agent-ready</p>
          <p class="text-sm text-cloud/75 mt-2">Expón la misma confianza cualificada como servidor <span class="mono text-cloud">MCP</span>: tus agentes de IA invocan firma o sello como herramienta nativa, con los guardrails del QTSP.</p>
        </div>
        <a href="/soluciones/la-factoria" class="link-underline inline-flex items-center gap-2 text-green text-sm font-medium mt-7">Ver La Factoría <i class="ph ph-arrow-right"></i></a>
      </div>
      <div class="lg:col-span-7 reveal">
        <div class="rounded-2xl overflow-hidden border border-cloud/10 shadow-2xl shadow-black/50">
          <div class="flex items-center gap-2 px-4 py-3 bg-ink border-b border-cloud/10">
            <span class="w-3 h-3 rounded-full bg-red-400/50"></span><span class="w-3 h-3 rounded-full bg-lime/60"></span><span class="w-3 h-3 rounded-full bg-green/70"></span>
            <span class="ml-3 mono text-xs text-cloud/55">trust-api · sellar evidencia</span>
          </div>
          <pre class="mono text-[12.5px] leading-relaxed bg-coal text-cloud/80 p-5 overflow-x-auto"><span class="text-cloud/55"># Por API REST: una operación, una evidencia</span>
<span class="text-green">POST</span> https://api.eadtrust.eu/v2/<span class="lime-text">evidence</span>
<span class="text-cloud/50">Authorization:</span> Bearer ••••••
&#123;
  <span class="lime-text">"operation"</span>: <span class="text-cloud">"albaran.entrega"</span>,
  <span class="lime-text">"payload_hash"</span>: <span class="text-cloud">"a3f9…"</span>,
  <span class="lime-text">"qualified"</span>: <span class="text-green">true</span>
&#125;
<span class="text-cloud/55">→ 201 · evidencia eIDAS cualificada + sello de tiempo</span>

<span class="text-cloud/55"># Por MCP: para tu agente de IA</span>
<span class="lime-text">tool</span>: trust.<span class="text-green">seal_evidence</span>(&#123; operation, payload_hash &#125;)</pre>
        </div>
        <p class="mono text-[11px] text-cloud/50 mt-3">* Fragmento ilustrativo. Endpoints y specs definitivos en la página de la línea.</p>
      </div>
    </div>
  </section>

  <!-- 04 · POR PERFIL -->
  <section id="perfil" class="relative grain bg-coal/60 py-24 lg:py-32 border-y border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl reveal">
        <SectionLabel num="04" text="Tu punto de entrada" />
        <h2 class="head display text-4xl lg:text-[3.1rem] text-cloud font-semibold">¿Desde dónde miras el problema?</h2>
        <p class="mt-6 text-cloud/70">Cada perfil entra por su propia línea. Elige el tuyo.</p>
      </div>
      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="card rounded-2xl p-7 reveal"><i class="ph ph-gavel text-green text-3xl"></i><h3 class="head text-cloud font-semibold mt-5">Legal / Compliance</h3><p class="text-cloud/55 text-sm mt-3 leading-relaxed">"Necesito que cada operación genere prueba oponible."</p><a href="/soluciones/confianza-digital" class="link-underline inline-flex items-center gap-1.5 text-green text-sm font-medium mt-5">Confianza Digital <i class="ph ph-arrow-right"></i></a></div>
        <div class="card rounded-2xl p-7 reveal"><i class="ph ph-file-text text-lime text-3xl"></i><h3 class="head text-cloud font-semibold mt-5">General Counsel / Ops</h3><p class="text-cloud/55 text-sm mt-3 leading-relaxed">"Gestiono miles de contratos sin visibilidad de mi posición."</p><a href="/soluciones/contract-tech" class="link-underline inline-flex items-center gap-1.5 text-lime text-sm font-medium mt-5">Contract Tech <i class="ph ph-arrow-right"></i></a></div>
        <div class="card rounded-2xl p-7 reveal"><i class="ph ph-coins text-aqua text-3xl"></i><h3 class="head text-cloud font-semibold mt-5">Financiero / Mercados</h3><p class="text-cloud/55 text-sm mt-3 leading-relaxed">"Quiero tokenizar activos con un marco que aguante al regulador."</p><a href="/soluciones/activos-digitales" class="link-underline inline-flex items-center gap-1.5 text-aqua text-sm font-medium mt-5">Activos Digitales <i class="ph ph-arrow-right"></i></a></div>
        <div class="card rounded-2xl p-7 reveal"><i class="ph ph-brain text-azure text-3xl"></i><h3 class="head text-cloud font-semibold mt-5">Riesgo / DPO / Consejo</h3><p class="text-cloud/55 text-sm mt-3 leading-relaxed">"Tengo que gobernar la IA y demostrar el cumplimiento."</p><a href="/soluciones/grc-ia" class="link-underline inline-flex items-center gap-1.5 text-azure text-sm font-medium mt-5">GRC &amp; IA <i class="ph ph-arrow-right"></i></a></div>
      </div>
    </div>
  </section>

  <!-- 05 · QUÉ COMPARTEN + PRUEBA -->
  <section class="relative grain py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-3 gap-8">
        {comparten.map((c) => (
          <div class="reveal"><i class={`ph ${c.icon} text-green text-3xl`}></i><h3 class="head text-xl text-cloud mt-4 font-semibold">{c.t}</h3><p class="text-cloud/60 text-sm mt-3 leading-relaxed">{c.d}</p></div>
        ))}
      </div>
      <div class="hairline my-16"></div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div class="reveal"><div class="head text-5xl font-semibold green-text"><span class="counter" data-to="40000" data-suffix="+">40.000+</span></div><p class="text-cloud/55 text-sm mt-2">evidencias en GoCertius</p></div>
        <div class="reveal"><div class="head text-5xl font-semibold green-text"><span class="counter" data-to="298" data-suffix="+">298+</span></div><p class="text-cloud/55 text-sm mt-2">escenarios de integración</p></div>
        <div class="reveal"><div class="head text-5xl font-semibold green-text"><span class="counter" data-to="4">4</span></div><p class="text-cloud/55 text-sm mt-2">líneas de negocio</p></div>
        <div class="reveal"><div class="head text-5xl font-semibold green-text">Top&nbsp;10</div><p class="text-cloud/55 text-sm mt-2">FT Innovative Lawyers (Europa)</p></div>
      </div>
      <div class="mt-16 reveal">
        <p class="label text-cloud/55 text-center mb-7">Ecosistema y partners</p>
        <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-5 text-cloud/50 head">
          <span class="text-lg">Garrigues</span><span class="mono text-sm tracking-wide">EADTrust</span><span class="font-semibold">ioBuilders</span><span class="font-semibold">Oracle</span><span class="font-semibold">Microsoft</span><span class="text-sm">Observatorio LegalTech Garrigues·ICADE</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 · RECURSOS -->
  <section id="recursos" class="relative grain bg-coal/60 py-24 lg:py-32 border-y border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-wrap items-end justify-between gap-6 reveal">
        <div><SectionLabel num="05" text="Aprende la categoría" /><h2 class="head display text-4xl lg:text-[3rem] text-cloud font-semibold">Recursos para adelantarte.</h2></div>
        <a href="/recursos" class="link-underline text-green font-medium text-sm inline-flex items-center gap-2">Ver todos los recursos <i class="ph ph-arrow-right"></i></a>
      </div>
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articulos.map((a) => (
          <a href="/recursos" class="card rounded-2xl p-7 group flex flex-col reveal">
            <div class="flex items-center justify-between mb-3"><span class="label text-green">{a.catLabel}</span><span class="mono text-[11px] text-cloud/55">{a.fecha}</span></div>
            <h3 class="head text-lg text-cloud leading-snug font-semibold">{a.titulo}</h3>
            <p class="text-cloud/55 text-sm mt-3 flex-1">{a.extracto}</p>
            <span class="inline-flex items-center gap-1.5 text-green text-sm font-medium mt-5">Ver en recursos <i class="ph ph-arrow-right group-hover:translate-x-1 transition-transform"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="relative grain overflow-hidden border-t border-cloud/10">
    <Wireframe variant="ribbon" class="absolute left-[-6rem] bottom-[-5rem] w-[30rem] h-[30rem] opacity-45 hidden md:block" accent={false} />
    <div class="relative max-w-5xl mx-auto px-6 py-28 text-center">
      <span class="stamp inline-flex items-center gap-2 mono text-[11px] tracking-widest text-green border border-green/40 rounded-full px-4 py-1.5 mb-8"><i class="ph ph-shield-check"></i> g-digital · GRUPO GARRIGUES</span>
      <h2 class="head display text-4xl lg:text-6xl text-cloud font-semibold">Pon tu reto sobre la mesa.</h2>
      <p class="mt-7 text-cloud/70 max-w-xl mx-auto text-lg">Cuéntanos un caso real —un contrato, una operación, una tokenización, un sistema de IA— y te mostramos qué línea lo resuelve y cómo.</p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto" class="bg-green text-ink px-8 py-4 rounded-xl font-semibold hover:bg-lime transition-colors">Solicitar una conversación</a>
        <a href="#lineas" class="border border-cloud/25 text-cloud px-8 py-4 rounded-xl font-medium hover:bg-cloud/5 transition-colors">Ver las 4 líneas</a>
      </div>
      <p class="mono text-[11px] text-cloud/55 mt-8">Tratamiento de datos por J&amp;A Garrigues, S.L.P. · Consulta la política de privacidad antes de enviar.</p>
    </div>
  </section>
</Base>
