---
import LineaPage from '../layouts/LineaPage.astro';
import SectionIntro from '../components/SectionIntro.astro';

// Assets locales (self-hosted; antes hotlink al Drupal legacy).
const equipo = [
  { img: 'g-digital-eduardo-abad.jpg', name: 'Eduardo Abad', role: 'Socio responsable de innovación y digitalización de Garrigues. Lidera g-digital dentro de la estrategia del despacho, impulsando la transformación digital y las soluciones tecno-legales.', li: 'https://www.linkedin.com/in/eduardo-abad-valdenebro-0699531' },
  { img: 'g-digital-moises-menendez.jpg', name: 'Moisés Menéndez', role: 'Dirige g-digital, liderando el desarrollo e implementación de la cartera de soluciones digitales innovadoras.', li: 'https://www.linkedin.com/in/moises-menendez-b4608a10' },
  { img: 'g-digital-oscar-del-barrio.jpg', name: 'Oscar del Barrio', role: 'Supervisa el desarrollo de producto y las operaciones de g-digital, con soporte a la gestión de negocios relacionados como EADTrust.', li: 'https://www.linkedin.com/in/oscar-del-barrio-aa78056' },
  { img: 'g-digital-hugo-alonso.jpg', name: 'Hugo Alonso', role: 'Lidera el desarrollo de las soluciones, coordinando los equipos de desarrollo interno y externo, con un trabajo orientado a la calidad del producto.', li: 'https://www.linkedin.com/in/vhalonso' },
  { img: 'g-digital-belen-aguayo.jpg', name: 'Belén Aguayo', role: 'Abogada experta en legaltech y product owner de las soluciones; coordina la colaboración entre los profesionales de Garrigues y g-digital.', li: 'https://www.linkedin.com/in/belen-aguayo-ms' },
  { img: 'g-digital-albi-rodriguez.jpg', name: 'Albi Rodríguez', role: 'Coordina la gestión del Observatorio legaltech y la difusión de g-digital en la región Latam.', li: 'https://www.linkedin.com/in/albi-rodriguez-jaramillo-67413b21' },
];

const capacidades = [
  { phase: '01 · Diseño jurídico', icon: 'ph-scales', name: 'Garrigues', tag: 'El primer despacho de la UE', body: 'Firma internacional de servicios legales y fiscales que asesora a nivel local, regional y global desde todos los ángulos del derecho de los negocios.' },
  { phase: '02 · Derecho digital', icon: 'ph-globe-hemisphere-west', name: 'Garrigues Digital', tag: 'Equipo experto en derecho digital', body: 'Equipo transversal de profesionales que, desde las distintas áreas de práctica, asesora a las empresas en torno al negocio digital (TechLaw).' },
  { phase: '03 · Tecnología y producto', icon: 'ph-code', name: 'g-digital', tag: 'Desarrolladores de LawTech', body: 'Desarrolla soluciones tecnológicas avanzadas para los servicios legales y actúa como palanca interna de transformación digital del despacho.' },
  { phase: '04 · Prestación cualificada', icon: 'ph-seal-check', name: 'EADTrust', tag: 'QTSP regulado · participación del 51%', body: 'Prestador cualificado de servicios de confianza (eIDAS). Opera y custodia —en un entorno regulado y supervisado— lo que g-digital diseña e implementa.' },
];

const partners = [
  { icon: 'ph-cube', name: 'ioBuilders', tag: 'Partner tecnológico · blockchain', body: 'Experiencia en soluciones blockchain con foco en seguridad, eficiencia y cumplimiento. Estamos en su capital.', href: 'https://io.builders/' },
  // VALIDAR plan:gdw:w-factoria-arquitectura #41
  { icon: 'ph-cloud', name: 'Microsoft Azure', tag: 'Cloud EU Sovereign', body: 'Seguridad y escalabilidad para las soluciones de confianza digital.', href: '' },
  // VALIDAR plan:gdw:w-factoria-arquitectura #41
  { icon: 'ph-database', name: 'Oracle Cloud', tag: 'Cloud EU Sovereign', body: 'Plataforma robusta para la gestión de datos y aplicaciones empresariales en procesos digitales complejos.', href: '' },
];

const gobierno = [
  { name: 'José Ramón Morales', href: 'https://www.garrigues.com/es_ES/equipo/jose-ramon-morales' },
  { name: 'Cristina Mesa Sánchez', href: 'https://www.garrigues.com/es_ES/equipo/cristina-mesa-sanchez' },
  { name: 'Alejandro Padín Vidal', href: 'https://www.garrigues.com/es_ES/equipo/alejandro-padin-vidal' },
  { name: 'Alejandro Huertas León', href: 'https://www.garrigues.com/es_ES/equipo/alejandro-huertas-leon' },
];
---
<LineaPage
  kicker="Nosotros"
  title="Diseñamos la tecnología legal del Grupo Garrigues"
  intro="g-digital es la división de negocios digitales de Garrigues. Integramos el conocimiento jurídico del despacho en soluciones que mejoran la eficiencia, fortalecen la seguridad jurídica y crean nuevas oportunidades en un entorno regulado."
  cta="Contacta con el equipo"
>
  <!-- Misión (papel) -->
  <section class="surface-paper py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5">
        <SectionIntro label="Nuestra misión" title="Tecnología real para situaciones de alta complejidad jurídica." />
      </div>
      <div class="lg:col-span-7 lg:pt-4">
        <p class="t1 text-lg leading-relaxed">Desarrollamos soluciones tecnológicas que integran nuestro conocimiento del derecho de los negocios en los procesos de nuestros clientes: no solo mejorando la eficiencia y la seguridad jurídica, sino habilitando nuevas oportunidades de negocio en un entorno cada vez más digital.</p>
        <p class="mt-5 t2 leading-relaxed">Nuestras soluciones están concebidas como herramientas esenciales para reforzar la seguridad jurídica, la eficiencia y el cumplimiento normativo en los procesos críticos de cada organización.</p>
      </div>
    </div>
  </section>

  <!-- Vídeo de presentación (tinta, vídeo real self-hosted) -->
  <section class="surface-ink grain py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <p class="label accent mb-6 text-center">g-digital en un minuto</p>
      <div class="rounded-2xl overflow-hidden border shadow-2xl shadow-black/40 reveal" style="border-color:var(--line)">
        <video controls preload="none" poster="/video/nosotros-poster.jpg" class="w-full block bg-ink">
          <source src="/video/g-digital-presentacion.mp4" type="video/mp4" />
          Tu navegador no soporta vídeo HTML5.
        </video>
      </div>
    </div>
  </section>

  <!-- Modelo 360 de capacidades (papel) -->
  <section class="surface-paper py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <SectionIntro
        label="Modelo 360 de capacidades"
        title="Del diseño jurídico a la implementación, en una sola casa."
        lead="No es una suma de proveedores: es una capacidad <strong>360º</strong> que cubre todo el ciclo de una solución digital — del diseño jurídico a la implementación tecnológica y su prestación en un entorno cualificado y regulado."
      />
      <div class="mt-12">
        {capacidades.map((t) => (
          <div class="grid lg:grid-cols-12 gap-x-8 gap-y-2 py-7 border-t items-baseline reveal" style="border-color:var(--line)">
            <span class="lg:col-span-2 mono text-[11px] t3">{t.phase}</span>
            <h3 class="lg:col-span-3 head text-xl t1 font-semibold">{t.name}</h3>
            <p class="lg:col-span-2 label t3">{t.tag}</p>
            <p class="lg:col-span-5 t2 text-sm leading-relaxed">{t.body}</p>
          </div>
        ))}
        <div class="border-t" style="border-color:var(--line)"></div>
      </div>
    </div>
  </section>

  <!-- EADTrust 51% (banda navy) -->
  <section class="surface-navy py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-4">
        <p class="mono accent text-sm mb-2">PARTICIPACIÓN GARRIGUES</p>
        <p class="head display t1 font-semibold text-7xl lg:text-8xl leading-none">51<span class="accent">%</span></p>
        <p class="t2 mt-4">en EADTrust, el QTSP del Grupo Garrigues.</p>
      </div>
      <div class="lg:col-span-8">
        <p class="label accent mb-4">El prestador cualificado del grupo</p>
        <h2 class="display-2 t1 font-semibold">EADTrust opera lo que g-digital diseña.</h2>
        <p class="mt-6 t2 leading-relaxed">La adquisición del 51% de EADTrust por parte de Garrigues es la pieza que hace realidad los productos de g-digital: ofrece un entorno seguro, certificado, regulado y altamente especializado para los clientes del despacho.</p>
        <p class="mt-4 t3 leading-relaxed">Los productos de g-digital, apoyados por los expertos de Garrigues, se implementan en un marco cualificado y supervisado (eIDAS) y están diseñados para operar en contextos críticos.</p>
        <a href="https://es.linkedin.com/company/eadtrust" target="_blank" rel="noopener" class="inline-flex items-center gap-2 accent text-sm font-medium mt-6">Conoce EADTrust <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <!-- Partners (papel) -->
  <section class="surface-paper py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <SectionIntro label="Nuestros partners" title="Partners tecnológicos de nuestras soluciones." />
      <div class="mt-12 grid md:grid-cols-3 gap-6 reveal-group">
        {partners.map((p) => (
          <article class="card-s rounded-2xl p-7">
            <i class={`ph ${p.icon} text-3xl`} style="color:var(--teal)" aria-hidden="true"></i>
            <h3 class="head text-xl t1 mt-4 font-semibold">{p.name}</h3>
            <p class="label t3 mt-2">{p.tag}</p>
            <p class="t2 text-sm mt-4 leading-relaxed">{p.body}</p>
            {p.href && <a href={p.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 accent text-sm font-medium mt-4">Saber más <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Observatorio (banda teal) -->
  <section class="surface-teal py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-8">
        <p class="label accent mb-4">Observatorio legaltech Garrigues · ICADE</p>
        <h2 class="display-2 t1 font-semibold">Un punto de encuentro para la investigación del sector legal.</h2>
        <p class="mt-5 t2 leading-relaxed">Un espacio abierto para los actores de la industria legal que quieren compartir experiencias y conocimiento sobre cómo la tecnología está transformando el sector, y analizar los desafíos y oportunidades para la profesión y el negocio.</p>
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <a href="https://www.comillas.edu/investigacion/observatorio-legaltech/" target="_blank" rel="noopener" class="btn-primary inline-flex items-center gap-2 px-6 py-3.5 rounded-xl">Ir al Observatorio <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <!-- Equipo (papel, fotografía duotone) -->
  <section class="surface-paper py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <SectionIntro
        label="Nuestros profesionales"
        title="Derecho, tecnología y consultoría estratégica en un mismo equipo."
        lead="El motor de g-digital reúne perfiles que hacen posible el enfoque integral de nuestras soluciones y su integración a medida en los procesos de cada cliente."
      />
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-group">
        {equipo.map((m) => (
          <article class="card-s rounded-2xl p-6 flex flex-col">
            <div class="duotone rounded-xl mb-5">
              <img src={`/equipo/${m.img}`} alt={`Retrato de ${m.name}`} loading="lazy" class="w-full aspect-[4/5] object-cover object-top block" />
            </div>
            <h3 class="head text-lg t1 font-semibold">{m.name}</h3>
            <p class="t2 text-sm mt-2 leading-relaxed flex-1">{m.role}</p>
            <a href={m.li} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 accent text-sm font-medium mt-4"><i class="ph ph-linkedin-logo" aria-hidden="true"></i> LinkedIn</a>
          </article>
        ))}
      </div>

      <!-- Gobierno Garrigues -->
      <div class="mt-16">
        <p class="label t3 mb-6">Profesionales de Garrigues en el gobierno de g-digital</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 reveal-group">
          {gobierno.map((g) => (
            <a href={g.href} target="_blank" rel="noopener" class="card-s rounded-xl p-5 flex items-center justify-between group">
              <span class="t1 text-sm font-medium">{g.name}</span>
              <i class="ph ph-arrow-up-right accent transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</LineaPage>
