---
import Linea from '../../layouts/Linea.astro';
import LineaExtra from '../../components/LineaExtra.astro';
import poster from '../../assets/infografias/04-grc-ia.svg?raw';

const aims = [
  ['Registro', 'Catálogo completo de todos los sistemas de IA de la organización.'],
  ['Clasificación', 'Categorización por nivel de riesgo y cumplimiento normativo.'],
  ['Monitoreo', 'Seguimiento continuo del rendimiento y la conformidad regulatoria.'],
  ['Evidencia', 'Documentación y trazabilidad de conformidad. Auditoría WORM.'],
];
const grc = [
  { icon: 'ph-compass', title: 'GRC Compass Core', body: '16 módulos especializados. Arquitectura multi-tenant con RLS y 31 roles RBAC.' },
  { icon: 'ph-lock', title: 'Audit WORM', body: 'Almacenamiento inmutable Write Once, Read Many. Trazabilidad completa de operaciones.' },
  { icon: 'ph-squares-four', title: 'Multi-dominio', body: 'RGPD, Prevención, Canal de Denuncias, AI Act, NIS2, DORA, ESG. Un framework, múltiples dominios.' },
];
---
<Linea
  linea="Línea 04 · nueva"
  tone="azure"
  motif="spiral"
  kicker="GRC & IA"
  title="IA aplicada al derecho: cumplimiento y gobernanza."
  intro="Acompañamos a Garrigues con tecnología: la pieza que hace demostrable el gobierno de tu IA. Servicio híbrido tecnología + derecho, diseñado para facilitar la conformidad con el AI Act."
  cta="Solicitar demo de GRC & IA"
>
  <LineaExtra slug="grc-ia" />

  <!-- Cumplimiento & gobernanza -->
  <section class="relative grain py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label text-green mb-6">Cumplimiento &amp; Gobernanza IA</p>
      <h2 class="head display text-3xl lg:text-[2.6rem] text-cloud font-semibold max-w-3xl">IA sin gobierno ni trazabilidad no es viable en operaciones empresariales.</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="card rounded-2xl p-6 reveal"><i class="ph ph-gavel text-green text-2xl"></i><h3 class="head text-cloud font-semibold mt-3">Cumplimiento AI Act</h3><p class="text-cloud/60 text-sm mt-2">Alineación con la normativa europea de IA en cada proceso que la emplea.</p></div>
        <div class="card rounded-2xl p-6 reveal"><i class="ph ph-shield text-green text-2xl"></i><h3 class="head text-cloud font-semibold mt-3">Diseño de guardarraíles</h3><p class="text-cloud/60 text-sm mt-2">Límites y protecciones para un comportamiento seguro y predecible.</p></div>
        <div class="card rounded-2xl p-6 reveal"><i class="ph ph-magnifying-glass text-green text-2xl"></i><h3 class="head text-cloud font-semibold mt-3">Análisis de sistemas IA</h3><p class="text-cloud/60 text-sm mt-2">Asistentes, scoring, filtrado de CV y otras aplicaciones de IA.</p></div>
        <div class="card rounded-2xl p-6 reveal"><i class="ph ph-handshake text-green text-2xl"></i><h3 class="head text-cloud font-semibold mt-3">Híbrido Tech + Derecho</h3><p class="text-cloud/60 text-sm mt-2">Expertise tecnológico + conocimiento jurídico de Garrigues.</p></div>
      </div>
    </div>
  </section>

  <!-- AIMS Console -->
  <section class="relative grain bg-coal/60 py-20 lg:py-28 border-y border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label text-green mb-6">AIMS Console · AI Act · ISO/IEC 42001</p>
      <h2 class="head display text-3xl lg:text-[2.4rem] text-cloud font-semibold max-w-3xl">Registrar, clasificar y monitorizar la conformidad de tus sistemas de IA.</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {aims.map(([t, d], i) => (
          <div class="card rounded-2xl p-6 reveal"><span class="mono text-green text-sm">0{i + 1}</span><h3 class="head text-cloud font-semibold mt-2">{t}</h3><p class="text-cloud/60 text-sm mt-2">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- GRC -->
  <section class="relative grain py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label text-green mb-6">Gobernanza, Riesgo y Cumplimiento</p>
      <h2 class="head display text-3xl lg:text-[2.4rem] text-cloud font-semibold max-w-3xl">Obligaciones → Riesgos → Controles → Evidencias → Incidencias.</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {grc.map((g) => (
          <article class="card rounded-2xl p-7 reveal"><i class={`ph ${g.icon} text-green text-3xl`}></i><h3 class="head text-lg text-cloud mt-4 font-semibold">{g.title}</h3><p class="text-cloud/65 text-sm mt-3 leading-relaxed">{g.body}</p></article>
        ))}
      </div>
    </div>
  </section>
  <!-- La línea de un vistazo (infografía) -->
  <section class="relative grain py-20 lg:py-28 border-t border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label text-azure mb-6">La línea de un vistazo</p>
      <div class="max-w-[460px] mx-auto rounded-2xl border border-cloud/10 overflow-hidden shadow-2xl shadow-black/40 reveal [&>svg]:block [&>svg]:w-full [&>svg]:h-auto">
        <Fragment set:html={poster} />
      </div>
    </div>
  </section>
</Linea>
