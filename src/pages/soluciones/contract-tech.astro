---
import ParaProfundizar from '../../components/ParaProfundizar.astro';
import LineaPage from '../../layouts/LineaPage.astro';
import LineaExtra from '../../components/LineaExtra.astro';
import poster from '../../assets/infografias/02-contract-tech.svg?raw';

const modelos = [
  { tag: 'BLOCKS', title: 'Soporte a tu estrategia digital', body: 'Integración de servicios de confianza cualificados en tu hoja de ruta. Cada transición contractual genera prueba criptográfica y trazabilidad eIDAS.' },
  { tag: 'MONO-CLM', title: 'CLM por tipo de contrato', body: 'Blueprint Packs para arrendamientos, préstamos, seguros y contratos comerciales. Flujos optimizados, reglas de negocio y dashboard sectorial.' },
  { tag: 'POSICIÓN', title: 'CLM Console General', body: 'Plataforma de gobernanza contractual para toda la organización. Gestiona tu cartera como activo estratégico.' },
];
const fases = [
  ['Preparación', 'Negociación, borrador, feedback. Historial de cambios con timestamps.'],
  ['Formalización', 'Firma cualificada, sellado temporal y hash criptográfico.'],
  ['Ejecución', 'Cumplimiento, hitos, pagos, ajustes. Eventos de hito y comprobantes.'],
  ['Terminación', 'Cierre, finiquito, archivo. Certificado de cumplimiento.'],
];
---
<LineaPage
  linea="Línea 02"
  tone="lime"
  motif="ribbon"
  kicker="Contract Tech"
  title="Del contrato como documento al contrato como proceso."
  intro="Gestión integral del ciclo de vida contractual con motores de reglas, evidencia cualificada y visión de posición contractual. CLM en tres dimensiones de madurez."
  cta="Solicitar demo de Contract Tech"
>
  <LineaExtra slug="contract-tech" />

  <!-- Problema -->
  <section class="relative grain py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label text-lime mb-6">Más allá del documento</p>
      <h2 class="head display text-3xl lg:text-[2.6rem] text-cloud font-semibold max-w-3xl">Los contratos son sistemas vivos, no PDFs estáticos.</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        <div class="card rounded-2xl p-6 reveal"><i class="ph ph-code-block text-lime text-2xl"></i><h3 class="head text-cloud font-semibold mt-3">Reglas enterradas en código</h3><p class="text-cloud/60 text-sm mt-2">La lógica contractual reside en sistemas legados, dispersa y sin visibilidad.</p></div>
        <div class="card rounded-2xl p-6 reveal"><i class="ph ph-eye-slash text-lime text-2xl"></i><h3 class="head text-cloud font-semibold mt-3">Falta de trazabilidad</h3><p class="text-cloud/60 text-sm mt-2">Cambios, eventos y transiciones sin registro auditable en tiempo real.</p></div>
        <div class="card rounded-2xl p-6 reveal"><i class="ph ph-stack-minus text-lime text-2xl"></i><h3 class="head text-cloud font-semibold mt-3">Posición contractual invisible</h3><p class="text-cloud/60 text-sm mt-2">Sin visibilidad consolidada de derechos, obligaciones y riesgos.</p></div>
      </div>
    </div>
  </section>

  <!-- Tres modelos -->
  <section class="relative grain bg-coal/60 py-20 lg:py-28 border-y border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label text-lime mb-6">Tres dimensiones de servicio</p>
      <div class="grid md:grid-cols-3 gap-6">
        {modelos.map((m) => (
          <article class="card rounded-2xl p-7 reveal"><span class="mono text-[11px] text-lime">{m.tag}</span><h3 class="head text-xl text-cloud mt-2 font-semibold">{m.title}</h3><p class="text-cloud/65 text-sm mt-4 leading-relaxed">{m.body}</p></article>
        ))}
      </div>
    </div>
  </section>

  <!-- Contrato computable -->
  <section class="relative grain py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label text-lime mb-6">Contrato computable · ciclo de vida</p>
      <h2 class="head display text-3xl lg:text-[2.4rem] text-cloud font-semibold max-w-3xl">Un autómata de estados dirigido por eventos, auditable.</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {fases.map(([t, d], i) => (
          <div class="card rounded-2xl p-6 reveal"><span class="mono text-lime text-sm">0{i + 1}</span><h3 class="head text-cloud font-semibold mt-2">{t}</h3><p class="text-cloud/60 text-sm mt-2">{d}</p></div>
        ))}
      </div>
      <div class="mt-10 grid md:grid-cols-2 gap-5">
        <div class="card rounded-xl p-6 reveal"><h3 class="head text-cloud font-semibold flex items-center gap-2"><i class="ph ph-shield-check text-lime"></i> Contract Guardian (IA)</h3><p class="text-cloud/65 text-sm mt-3">Agente IA que monitorea cambios, vencimientos, incumplimientos y oportunidades en tu cartera.</p></div>
        <div class="card rounded-xl p-6 reveal"><h3 class="head text-cloud font-semibold flex items-center gap-2"><i class="ph ph-git-branch text-lime"></i> Estándares abiertos</h3><p class="text-cloud/65 text-sm mt-3">Accord Project, Catalá, DMN, eIDAS. Motores de reglas, no hardcoding. De lo transaccional a lo estratégico.</p></div>
      </div>
    </div>
  </section>
  <!-- La línea de un vistazo (infografía) -->
  <section class="relative grain py-20 lg:py-28 border-t border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label text-lime mb-6">La línea de un vistazo</p>
      <div class="max-w-[460px] mx-auto rounded-2xl border border-cloud/10 overflow-hidden shadow-2xl shadow-black/40 reveal [&>svg]:block [&>svg]:w-full [&>svg]:h-auto">
        <Fragment set:html={poster} />
      </div>
    </div>
  </section>
<ParaProfundizar linea="contract" />
</LineaPage>
