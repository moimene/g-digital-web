---
import LineaPage from '../../layouts/LineaPage.astro';
import VideoBackground from '../../components/VideoBackground.astro';
import CertificationsBar from '../../components/CertificationsBar.astro';
import TrustLayerDiagram from '../../components/TrustLayerDiagram.astro';
import SectionIntro from '../../components/SectionIntro.astro';

const stack = [
  { icon: 'ph-fingerprint', title: 'Evidence Manager', sub: 'Inmutabilidad como servicio', body: 'Hashing SHA-256 + Qualified Timestamping (TSA). Perfiles XAdES-T/LTA con re-sellado. Verificabilidad offline.', law: 'Presunción de fecha (Art. 41.2 eIDAS) · Presunción reforzada (Art. 326.4 LEC)' },
  { icon: 'ph-pen-nib', title: 'Signature Manager', sub: 'Firma como servicio', body: 'Niveles AES y QES. Perfiles PAdES, XAdES, CAdES. QSCD cloud (Cloud HSM). SDK mobile.', law: 'Equivalencia a firma manuscrita (Art. 25.2 eIDAS)' },
  { icon: 'ph-envelope-simple', title: 'Notification Manager', sub: 'Entrega electrónica certificada', body: 'ERDS con prueba de envío, entrega y contenido con sellos cualificados. Comunicaciones laborales, regulatorias y contractuales.', law: 'ERDS (Arts. 43-44 Reglamento 910/2014)' },
  { icon: 'ph-archive', title: 'Custody Manager', sub: 'Custodia como servicio', body: 'Integridad a largo plazo (LTV). Perfiles PAdES-LTV/XAdES-LTA, re-sellado periódico. Nube soberana europea.', law: 'Integridad a largo plazo (LTV) · eIDAS' },
];
---
<LineaPage
  linea="Confianza Digital · Capa infraestructura"
  tone="green"
  motif="tunnel"
  kicker="La Factoría: Trust API + MCP"
  title="Una llamada REST. Evidencia legal cualificada."
  intro="Inyectamos servicios eIDAS por API o por MCP, para agentes de IA, de modo que cada operación sea evidencia probatoria. Sin migrar plataformas. Con QTSP propio del Grupo Garrigues. +298 escenarios en 18 sectores."
  cta="Probar Trust API en tu proceso crítico"
>
  <VideoBackground slot="media" src="/video/hero-factoria" poster="/video/hero-factoria-poster.jpg" overlay="aa" />

  <CertificationsBar />

  <!-- Deuda Legal -->
  <section class="surface-ink py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="label accent mb-5">El problema</p>
      <h2 class="display-2 t1 font-semibold">Tu organización acumula <span class="green-text">Deuda Legal</span>.</h2>
      <p class="mt-6 t2 max-w-2xl mx-auto leading-relaxed">Igual que la deuda técnica, son operaciones sin validez probatoria que se acumulan en silencio. No duelen hasta que las necesitas: ante un juez, un regulador o un auditor.</p>
    </div>
  </section>

  <!-- The Stack -->
  <section class="surface-coal py-20 lg:py-28 border-y border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <SectionIntro
        label="The Stack"
        title="Cuatro microservicios eIDAS. Una API unificada."
        lead={`La plataforma de base: un QTSP interno del Grupo Garrigues entregado como <span class="mono t1">rPaaS</span> (Regulated Platform as a Service). Integra servicios eIDAS regulados en cualquier proceso, sin migrar plataformas.`}
      />
      <div class="mt-12 grid md:grid-cols-2 gap-6 reveal-group">
        {stack.map((s) => (
          <article class="card-s rounded-2xl p-7">
            <i class={`ph ${s.icon} accent text-3xl`} aria-hidden="true"></i>
            <h3 class="head text-xl t1 mt-4 font-semibold">{s.title}</h3>
            <p class="accent text-sm mt-1">{s.sub}</p>
            <p class="t2 text-sm mt-4 leading-relaxed">{s.body}</p>
            <p class="mono text-[11px] t3 mt-4 border-t pt-3" style="border-color:var(--line)">{s.law}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Cómo se integra · Trust Layer animado -->
  <section class="surface-ink py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <SectionIntro
        label="Cómo se integra"
        title="Tu sistema + una llamada REST."
        lead={`No te obligamos a usar nuestra plataforma — <span class="t1 font-medium">nos integramos en la tuya</span>. Tu ERP, CRM, ECM, tus apps o tu low-code invocan la Trust API, y cada operación vuelve convertida en evidencia cualificada eIDAS.`}
      />
      <div class="mt-12">
        <TrustLayerDiagram />
      </div>
    </div>
  </section>

  <!-- MCP -->
  <section class="surface-ink py-20 lg:py-28 border-t border-cloud/10">
    <div class="max-w-5xl mx-auto px-6">
      <div class="rounded-2xl border p-8 reveal" style="border-color:rgba(var(--accent-rgb),.35);background:rgba(var(--accent-rgb),.08)">
        <p class="accent font-semibold flex items-center gap-2 text-lg"><i class="ph ph-robot" aria-hidden="true"></i> Agent-ready: confianza cualificada por MCP</p>
        <p class="t2 mt-3 leading-relaxed">Expón los mismos cuatro microservicios como servidor <span class="mono t1">MCP</span>. Tus agentes de IA invocan firma, sello o entrega como herramienta nativa, con los guardrails del QTSP y trazabilidad de cada invocación. La acumulación de innovación que diferencia a g-digital: de la API al agente.</p>
        <p class="t2 mt-3 leading-relaxed">Y no es un roadmap: hay <span class="t1 font-medium">tres servidores MCP publicados</span> en nuestro GitHub — <span class="mono t1">EAD-Factory-MCP</span>, <span class="mono t1">EAD_Enterprise_Suite_MCP</span> y <span class="mono t1">GoCertius_MCP</span> — conectables desde cualquier cliente MCP. <a href="https://github.com/g-digital-by-Garrigues" target="_blank" rel="noopener" class="link-underline accent">Ver los repositorios <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></p>
      </div>
    </div>
  </section>

  <!-- Trust Explorer · casos de uso -->
  <section class="surface-coal py-20 lg:py-28 border-y border-cloud/10">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <SectionIntro
          label="Trust Explorer · casos de uso"
          title="Míralo en una operación real."
          lead={`Elige un caso de uso y compara, paso a paso, la misma operación <span class="t1 font-medium">sin regulación</span> (deuda legal) frente a <span class="accent font-medium">con Trust API</span>: evento del cliente → llamada a la API → resultado legal, con el flujo de los cuatro managers.`}
        />
        <div class="mt-7 flex flex-wrap gap-2.5">
          {['Logística', 'InsurTech', 'PropTech', 'FinTech', 'Salud', 'Food', 'Energy · PPA', 'Banca', 'Archivo'].map((s) => (
            <span class="mono text-[11px] px-2.5 py-1 rounded-full border t3" style="border-color:var(--line)">{s}</span>
          ))}
        </div>
      </div>
      <div class="lg:col-span-5 lg:text-right">
        <a href="/escenarios" class="btn-primary inline-flex items-center gap-2 px-7 py-4 rounded-xl">Abrir el Trust Explorer <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>
</LineaPage>
