---
import ParaProfundizar from '../../components/ParaProfundizar.astro';
import LineaPage from '../../layouts/LineaPage.astro';
import LineaExtra from '../../components/LineaExtra.astro';
import PainPair from '../../components/PainPair.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import poster from '../../assets/infografias/01-confianza-digital.svg?raw';

const capas = [
  { href: '/soluciones/la-factoria', tag: 'INFRA', icon: 'ph-lightning', title: 'La Factoría (Trust API + MCP)', who: 'Para equipos técnicos que quieren inyectar eIDAS en sus sistemas', body: '4 microservicios eIDAS como primitivas REST: Evidence, Signature, Notification y Custody. Ahora también como servidor MCP para agentes de IA. JSON-native. Sin migrar plataformas.' },
  { href: '/soluciones/enterprise-suite', tag: 'PLATAFORMA', icon: 'ph-buildings', title: 'EAD Enterprise Suite', who: 'Para grandes organizaciones que necesitan una plataforma unificada', body: 'Agrega Signature Manager, Notice Manager, eArchiving y Credential Manager con soberanía digital. Crece incorporando nuevos servicios eIDAS 2.0 sin re-arquitectura.' },
  { href: '/soluciones/enterprise-suite', tag: 'PRODUCTO', icon: 'ph-squares-four', title: 'Soluciones diseñadas por g-digital', who: 'Productos individuales con UX empresarial, sueltos o dentro de la Suite', body: 'Signature Manager, Notice Manager (sustituye al burofax), eArchiving (LTV), Credential Manager (EUDI Wallet Ready). Diseñados por g-digital, operados por EADTrust.' },
  { href: 'https://www.gocertius.com', tag: 'EXPERIENCIA', icon: 'ph-device-mobile', title: 'GoCertius', who: 'Para profesionales y pymes sin integración técnica', body: 'SuperApp que agrega certificación de hechos, sello de tiempo cualificado, Chat Certificado y multimedia certificada. +40.000 evidencias en producción. Gratis en Google Play y App Store.' },
  { href: 'https://eadtrust.eu', tag: 'BASE QTSP', icon: 'ph-certificate', title: 'Servicios QTSP EADTrust', who: 'Servicios de confianza cualificados directos', body: 'La base regulada sobre la que todo se construye: firma con certificados, sellos RFC 3161, entrega certificada (ERDS), custodia LTV y credenciales. EUDI Wallet Ready.' },
];
const eidas2 = [
  ['Archivo Electrónico Cualificado', 'Arts. 45 decies y 45 undecies (45i-45j en la versión inglesa). Presunción de integridad y origen si el servicio figura en la lista de confianza.'],
  ['EUDI Wallet', 'Cartera digital europea. Interoperabilidad nativa.'],
  ['Declaración Electrónica Cualificada de Atributos (QEAA)', 'Arts. 45 ter-45 nonies (45b-45h en la versión inglesa). Mismo efecto jurídico que una declaración en papel expedida legalmente.'],
  ['QSCD Cloud', 'Firma cualificada en nube con autenticación fuerte.'],
  ['Registros Electrónicos (QEL)', 'Arts. 45 duodecies y 45 terdecies (45k-45l en la versión inglesa). Presunción de integridad y orden secuencial de las anotaciones si el servicio figura en la lista de confianza.'],
];
---
<LineaPage
  linea="Línea 01"
  tone="green"
  motif="sphere"
  kicker="Confianza Digital"
  title="Confianza Digital. Cinco formas de acceder."
  intro="Servicios eIDAS (firma, sello, entrega y certificados cualificados, y custodia a largo plazo) accesibles como API, MCP, plataforma enterprise, app móvil o servicios QTSP directos. No es un producto: es una arquitectura por capas."
>
  <LineaExtra slug="confianza-digital" />

  <!-- El dolor → la respuesta -->
  <section class="surface-coal py-16 border-b border-cloud/10">
    <div class="max-w-6xl mx-auto px-6">
      <PainPair
        pain="Tus operaciones digitales ocurren, pero no dejan prueba oponible. Cuando un juez, un regulador o un auditor lo reclama, no puedes demostrar qué pasó, cuándo, ni quién aceptó qué."
        fix="Servicios eIDAS —firma, sello y entrega cualificados, y custodia a largo plazo— que convierten cada operación en evidencia con presunción legal de integridad y fecha. Accesibles como API, MCP, plataforma o app."
      />
    </div>
  </section>

  <!-- Cinco capas -->
  <section class="surface-ink py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <SectionIntro
        label="Cinco tipologías de producto"
        title="Desde la infraestructura API hasta la app de bolsillo."
        lead="Cada tipología ofrece un nivel distinto de acceso a los mismos servicios eIDAS cualificados."
      />
      <div class="mt-12 space-y-4">
        {capas.map((c) => (
          <a href={c.href} class="card-s rounded-2xl p-7 reveal flex flex-col md:flex-row md:items-start gap-5">
            <div class="flex items-center gap-4 md:w-72 shrink-0">
              <i class={`ph ${c.icon} accent text-3xl`} aria-hidden="true"></i>
              <div><span class="mono text-[11px] accent block">{c.tag}</span><h3 class="head text-lg t1 font-semibold leading-tight">{c.title}</h3></div>
            </div>
            <div>
              <p class="t3 text-xs mb-2 italic">{c.who}</p>
              <p class="t2 text-sm leading-relaxed">{c.body}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GoCertius en producción (vídeo real de producto) -->
  <section class="surface-coal py-20 lg:py-24 border-y border-cloud/10">
    <div class="max-w-5xl mx-auto px-6">
      <SectionIntro
        label="Prueba en pantalla · GoCertius"
        title="Así certifica una evidencia GoCertius."
        lead="Vídeo real de lanzamiento (canal oficial de Garrigues): la app que ya suma +40.000 evidencias en producción."
      />
      <div class="mt-10 rounded-2xl overflow-hidden border shadow-2xl shadow-black/40 reveal" style="border-color:var(--line)">
        <video controls preload="none" poster="/video/gocertius-poster.jpg" class="w-full block bg-ink">
          <source src="/video/gocertius-launch.mp4" type="video/mp4" />
          Tu navegador no soporta vídeo HTML5.
        </video>
      </div>
      <p class="mono text-[11px] t3 mt-3">Garrigues × EADTrust · diciembre 2023 · 1 min</p>
    </div>
  </section>

  <!-- El modelo -->
  <section class="surface-ink py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6">
      <SectionIntro
        label="El modelo: diseño + operación"
        title="g-digital diseña con criterio jurídico de Garrigues. EADTrust opera y comercializa."
      />
      <div class="mt-12 grid md:grid-cols-3 gap-8 reveal-group">
        <div><div class="rule-strong mb-6" style="background:linear-gradient(90deg,rgba(var(--accent-rgb),.6),transparent)"></div><i class="ph ph-scales accent text-3xl" aria-hidden="true"></i><h3 class="head text-xl t1 mt-4 font-semibold">Garrigues</h3><p class="label t3 mt-2">Conocimiento jurídico</p><p class="t2 text-sm mt-4 leading-relaxed">80+ años de excelencia legal. Define los requisitos de cumplimiento que cada producto debe satisfacer.</p></div>
        <div><div class="rule-strong mb-6" style="background:linear-gradient(90deg,rgba(var(--accent-rgb),.6),transparent)"></div><i class="ph ph-code accent text-3xl" aria-hidden="true"></i><h3 class="head text-xl t1 mt-4 font-semibold">g-digital</h3><p class="label t3 mt-2">Diseño y desarrollo</p><p class="t2 text-sm mt-4 leading-relaxed">Diseña productos con Compliance by Design. Abogados y tecnólogos juntos desde la concepción.</p></div>
        <div><div class="rule-strong mb-6" style="background:linear-gradient(90deg,rgba(var(--accent-rgb),.6),transparent)"></div><i class="ph ph-certificate accent text-3xl" aria-hidden="true"></i><h3 class="head text-xl t1 mt-4 font-semibold">EADTrust</h3><p class="label t3 mt-2">Operación cualificada</p><p class="t2 text-sm mt-4 leading-relaxed">QTSP del Grupo Garrigues. Opera, comercializa y soporta. eadtrust.eu</p></div>
      </div>
    </div>
  </section>

  <!-- eIDAS 2.0 -->
  <section class="surface-coal py-20 lg:py-28 border-t border-cloud/10">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <SectionIntro
          label="Plataformas evolutivas"
          title="Preparadas para eIDAS 2.0 y la EUDI Wallet."
          lead="Enterprise Suite y GoCertius están diseñadas para incorporar los nuevos servicios eIDAS 2.0 a medida que la Comisión publica sus actos de ejecución y cada servicio obtiene su cualificación. Sin migraciones, sin re-arquitectura, sin interrupciones."
        />
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-4 reveal-group">
        {eidas2.map(([t, d]) => (
          <div class="card-s rounded-xl p-5"><h3 class="t1 font-semibold text-sm flex items-center gap-2"><i class="ph ph-sparkle accent" aria-hidden="true"></i>{t}</h3><p class="t3 text-sm mt-2">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- La línea de un vistazo (infografía) -->
  <section class="surface-ink py-20 lg:py-28 border-t border-cloud/10">
    <div class="max-w-7xl mx-auto px-6">
      <p class="label accent mb-6">La línea de un vistazo</p>
      <div class="max-w-[460px] mx-auto rounded-2xl border overflow-hidden shadow-2xl shadow-black/40 reveal [&>svg]:block [&>svg]:w-full [&>svg]:h-auto" style="border-color:var(--line)">
        <Fragment set:html={poster} />
      </div>
    </div>
  </section>
<ParaProfundizar linea="confianza" />
</LineaPage>
