---
import Base from '../../layouts/Base.astro';
import Wireframe from '../../components/Wireframe.astro';
import SectorDemo from '../../components/SectorDemo.astro';
import { escenariosCredito } from '../../data/demo-credito';
import CertificationsBar from '../../components/CertificationsBar.astro';

const ACCENT = '#22D3EE';
const LIVE = 'https://trustbankservices.lovable.app';
---
<Base
  title="Demostrador Banca · crédito al consumo | g-digital"
  description="Cómo la Trust API convierte un proceso de crédito al consumo en un expediente probatorio cualificado: 5 escenarios (oferta preconcedida, modificación, línea in-app, crédito estándar y agente IA) fase a fase."
>
  <header class="relative grain overflow-hidden border-b border-cloud/10">
    <Wireframe variant="grid" density="strong" color={`${ACCENT}80`} class="absolute right-[-12rem] top-20 w-[25rem] h-[25rem] opacity-20 md:right-[-7rem] md:top-1/2 md:-translate-y-1/2 md:w-[34rem] md:h-[34rem] md:opacity-45" />
    <div class="relative max-w-7xl mx-auto px-6 pt-20 pb-16 lg:pt-28 lg:pb-20">
      <a href="/escenarios" class="inline-flex items-center gap-1.5 text-cloud/55 hover:text-cloud text-sm mb-6"><i class="ph ph-arrow-left"></i> Trust Explorer</a>
      <p class="label mb-6" style={`color:${ACCENT}`}>Demostrador sectorial · Banca</p>
      <h1 class="head display text-cloud text-4xl sm:text-5xl lg:text-[3.8rem] font-semibold max-w-4xl">La deuda legal de los procesos de banca.</h1>
      <p class="mt-8 max-w-2xl text-lg text-cloud/70 leading-relaxed">Los bancos han digitalizado la contratación, pero siguen teniendo dificultades para demostrar qué ocurrió, cuándo y quién aceptó qué. Estos cinco escenarios de crédito al consumo muestran cómo la Trust API convierte cada interacción en evidencia verificable, fase a fase.</p>
      <div class="mt-9 flex flex-col sm:flex-row gap-4">
        <a href="#demo" class="bg-green text-ink px-7 py-3.5 rounded-xl font-semibold hover:bg-lime transition-colors">Recorrer escenarios</a>
        <a href={LIVE} target="_blank" rel="noopener" class="border border-cloud/25 text-cloud px-7 py-3.5 rounded-xl font-medium hover:bg-cloud/5 transition-colors inline-flex items-center gap-2">Prototipo interactivo · entorno externo <i class="ph ph-arrow-up-right"></i></a>
      </div>
    </div>
  </header>

  <CertificationsBar />

  <SectorDemo escenarios={escenariosCredito} accent={ACCENT} />

  <section class="relative grain bg-coal/60 py-16 border-y border-cloud/10">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-cloud/70 leading-relaxed">El demostrador interactivo completo —stepper por fases con vista de negocio y traza técnica, API Explorer, ledger de evidencias y certificado final descargable— está disponible como demo viva.</p>
      <a href={LIVE} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 bg-green text-ink px-7 py-3.5 rounded-xl font-semibold hover:bg-lime transition-colors">Prototipo interactivo · entorno externo <i class="ph ph-arrow-up-right"></i></a>
    </div>
  </section>

  <section class="relative grain overflow-hidden">
    <div class="relative max-w-4xl mx-auto px-6 py-20 text-center">
      <h2 class="head display text-3xl lg:text-4xl text-cloud font-semibold">¿Quieres este recorrido para tu proceso?</h2>
      <p class="mt-5 text-cloud/70 max-w-xl mx-auto">Lo adaptamos a tus operaciones críticas y te mostramos el expediente probatorio resultante.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto" class="bg-green text-ink px-8 py-4 rounded-xl font-semibold hover:bg-lime transition-colors">Solicitar workshop sectorial</a>
        <a href="/soluciones/la-factoria" class="border border-cloud/25 text-cloud px-8 py-4 rounded-xl font-medium hover:bg-cloud/5 transition-colors">Ver La Factoría</a>
      </div>
    </div>
  </section>
</Base>
