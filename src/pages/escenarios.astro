---
import Base from '../layouts/Base.astro';
import Wireframe from '../components/Wireframe.astro';
import { escenarios, LINEA_META, SECTORES, type EscLinea } from '../data/escenarios';

const lineas: { key: EscLinea | 'todas'; label: string }[] = [
  { key: 'todas', label: 'Todas' },
  { key: 'confianza', label: 'Confianza Digital' },
  { key: 'contract', label: 'Contract Tech' },
  { key: 'activos', label: 'Activos Digitales' },
  { key: 'grc', label: 'GRC & IA' },
];
---
<Base title="Escenarios: casos de uso | g-digital" description="Directorio de escenarios de g-digital clasificados por línea y sector: casos de uso tangibles de confianza digital, contract tech, activos digitales y GRC & IA, con una demo viva de sellado de evidencia.">
  <!-- HERO -->
  <header class="relative grain overflow-hidden border-b border-cloud/10">
    <Wireframe variant="grid" density="strong" class="absolute right-[-12rem] top-20 w-[26rem] h-[26rem] opacity-20 md:right-[-7rem] md:top-1/2 md:-translate-y-1/2 md:w-[34rem] md:h-[34rem] md:opacity-50" />
    <div class="relative max-w-7xl mx-auto px-6 pt-20 pb-16 lg:pt-28 lg:pb-20">
      <p class="label text-green mb-6">Escenarios</p>
      <h1 class="head display text-cloud text-4xl sm:text-5xl lg:text-[4rem] font-semibold max-w-4xl">Casos de uso, tangibles.</h1>
      <p class="mt-8 max-w-2xl text-lg text-cloud/70 leading-relaxed">No vendemos abstracciones. Aquí tienes escenarios reales por línea y sector — y una demo que puedes ejecutar ahora mismo.</p>
    </div>
  </header>

  <!-- DEMO VIVA -->
  <section class="relative grain py-16 lg:py-20 border-b border-cloud/10">
    <div class="max-w-5xl mx-auto px-6">
      <p class="label text-green mb-3">Demo viva</p>
      <h2 class="head display text-3xl lg:text-[2.4rem] text-cloud font-semibold">Sella una evidencia, ahora.</h2>
      <p class="mt-4 text-cloud/60 max-w-2xl">Escribe una operación y pulsa: tu navegador calcula el hash SHA-256 y genera una evidencia con sello de tiempo. Así de simple es <span class="text-cloud">Compliance Injection</span>.</p>
      <div class="mt-8 grid md:grid-cols-2 gap-6 items-start">
        <div class="card rounded-2xl p-6">
          <label class="block text-sm text-cloud/70">Operación a certificar</label>
          <input id="op" type="text" value="albaran.entrega · pedido 4815" class="mt-2 w-full bg-coal border border-cloud/15 rounded-lg px-4 py-3 text-cloud focus:border-green outline-none mono text-sm" />
          <button id="sellar" type="button" class="mt-4 inline-flex items-center gap-2 bg-green text-ink px-6 py-3 rounded-xl font-semibold hover:bg-lime transition-colors">Sellar evidencia <i class="ph ph-seal-check"></i></button>
          <p class="mono text-[11px] text-cloud/40 mt-3">* Demo 100% en tu navegador (SHA-256). En producción, el sello es cualificado por el QTSP (EADTrust).</p>
        </div>
        <div id="rescard" class="rounded-2xl p-6 bg-green/5 border border-green/30 hidden">
          <div class="flex items-center gap-2 text-green font-semibold"><i class="ph ph-seal-check text-lg"></i> Evidencia cualificada</div>
          <dl class="mt-4 space-y-2.5 text-sm mono">
            <div class="flex justify-between gap-4"><dt class="text-cloud/45">ID</dt><dd id="r-id" class="text-cloud text-right"></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-cloud/45">Operación</dt><dd id="r-op" class="text-cloud text-right truncate max-w-[60%]"></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-cloud/45">Fecha (UTC)</dt><dd id="r-time" class="text-cloud text-right"></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-cloud/45">SHA-256</dt><dd id="r-hash" class="text-green text-right break-all"></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-cloud/45">Cualificada</dt><dd class="text-green text-right">true</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- DIRECTORIO -->
  <section class="relative grain py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="label text-green mb-3">Directorio</p>
          <h2 class="head display text-3xl lg:text-[2.4rem] text-cloud font-semibold"><span id="esc-count">{escenarios.length}</span> escenarios por línea y sector.</h2>
        </div>
        <p class="mono text-[11px] text-cloud/45 max-w-xs">Selección inicial. Escalable al catálogo completo (+298) por línea, sector y caso.</p>
      </div>

      <!-- Filtros -->
      <div class="mt-8 flex flex-wrap gap-2.5">
        {lineas.map((l, i) => (
          <button type="button" data-fl={l.key} class={`fbtn-l text-sm px-4 py-2 rounded-full border transition-colors ${i === 0 ? 'border-green bg-green/15 text-green' : 'border-cloud/15 text-cloud/60 hover:text-cloud hover:border-cloud/40'}`}>{l.label}</button>
        ))}
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" data-fs="todos" class="fbtn-s text-xs px-3 py-1.5 rounded-full border border-green/40 bg-green/10 text-green transition-colors">Todos los sectores</button>
        {SECTORES.map((s) => (
          <button type="button" data-fs={s} class="fbtn-s text-xs px-3 py-1.5 rounded-full border border-cloud/15 text-cloud/55 hover:text-cloud hover:border-cloud/40 transition-colors">{s}</button>
        ))}
      </div>

      <!-- Grid -->
      <div id="esc-grid" class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {escenarios.map((e) => (
          <article data-linea={e.linea} data-sector={e.sector} class="esc-card card rounded-2xl p-6 reveal flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class={`label ${LINEA_META[e.linea].toneText}`}>{LINEA_META[e.linea].label}</span>
              <span class="mono text-[11px] text-cloud/45">{e.sector}</span>
            </div>
            <h3 class="head text-cloud font-semibold leading-snug">{e.titulo}</h3>
            <p class="text-cloud/55 text-sm mt-2 leading-relaxed flex-1">{e.dolor}</p>
            <div class="mt-4 pt-3 border-t border-cloud/10 flex items-center justify-between gap-3 text-[11px] mono">
              <span class={LINEA_META[e.linea].toneText}>{e.servicio}</span>
              <span class="text-cloud/45 text-right">{e.norma}</span>
            </div>
          </article>
        ))}
      </div>
      <p id="esc-empty" class="hidden text-cloud/50 text-sm mt-8">No hay escenarios para esa combinación todavía.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative grain overflow-hidden border-t border-cloud/10">
    <div class="relative max-w-4xl mx-auto px-6 py-24 text-center">
      <h2 class="head display text-3xl lg:text-5xl text-cloud font-semibold">¿No ves tu caso?</h2>
      <p class="mt-6 text-cloud/70 max-w-xl mx-auto">Mapeamos tus operaciones críticas y te decimos qué escenarios aplican y cómo integrarlos.</p>
      <div class="mt-9 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto" class="bg-green text-ink px-8 py-4 rounded-xl font-semibold hover:bg-lime transition-colors">Mapear mis escenarios</a>
        <a href="/recursos#desarrolladores" class="border border-cloud/25 text-cloud px-8 py-4 rounded-xl font-medium hover:bg-cloud/5 transition-colors">Recursos para desarrolladores</a>
      </div>
    </div>
  </section>

  <script>
    // Demo viva: sellado SHA-256 en el navegador
    const sellar = document.getElementById('sellar');
    sellar?.addEventListener('click', async () => {
      const op = (document.getElementById('op') as HTMLInputElement)?.value?.trim() || 'operacion.demo';
      const ts = new Date().toISOString();
      let hex = '';
      try {
        const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(op + '|' + ts));
        hex = Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');
      } catch {
        hex = Math.random().toString(16).slice(2).padEnd(64, '0');
      }
      const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set('r-id', 'EV-' + ts.slice(0, 10).replace(/-/g, '') + '-' + hex.slice(0, 6).toUpperCase());
      set('r-op', op);
      set('r-time', ts.replace('T', ' ').slice(0, 19));
      set('r-hash', hex.slice(0, 28) + '…');
      document.getElementById('rescard')?.classList.remove('hidden');
    });

    // Filtros del directorio (línea + sector)
    let fl = 'todas', fs = 'todos';
    const cards = Array.from(document.querySelectorAll('.esc-card')) as HTMLElement[];
    const count = document.getElementById('esc-count');
    const empty = document.getElementById('esc-empty');
    const apply = () => {
      let shown = 0;
      cards.forEach((c) => {
        const ok = (fl === 'todas' || c.dataset.linea === fl) && (fs === 'todos' || c.dataset.sector === fs);
        c.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      if (count) count.textContent = String(shown);
      empty?.classList.toggle('hidden', shown > 0);
    };
    const activate = (btns: HTMLElement[], el: HTMLElement, on: string[], off: string[]) => {
      btns.forEach((b) => { b.classList.remove(...on); b.classList.add(...off); });
      el.classList.remove(...off); el.classList.add(...on);
    };
    const lBtns = Array.from(document.querySelectorAll('.fbtn-l')) as HTMLElement[];
    const sBtns = Array.from(document.querySelectorAll('.fbtn-s')) as HTMLElement[];
    lBtns.forEach((b) => b.addEventListener('click', () => { fl = b.dataset.fl || 'todas'; activate(lBtns, b, ['border-green', 'bg-green/15', 'text-green'], ['border-cloud/15', 'text-cloud/60']); apply(); }));
    sBtns.forEach((b) => b.addEventListener('click', () => { fs = b.dataset.fs || 'todos'; activate(sBtns, b, ['border-green/40', 'bg-green/10', 'text-green'], ['border-cloud/15', 'text-cloud/55']); apply(); }));
  </script>
</Base>
